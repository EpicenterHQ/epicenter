{
	"type": "object",
	"required": [
		"description"
	],
	"properties": {
		"$schema": {
			"type": "string"
		},
		"description": {
			"type": "string",
			"minLength": 1
		},
		"collections": {
			"type": "object",
			"patternProperties": {
				"^[a-z][a-z0-9-]*$": {
					"type": "object",
					"required": [
						"path",
						"fields"
					],
					"properties": {
						"path": {
							"type": "string",
							"pattern": "^(?!(.*/)?\\.\\.?(/|$))(?!.*//)(?!.*/$)[^/{}][^{}]*(\\{[A-Za-z_][A-Za-z0-9_]*\\}[^{}]*)?$",
							"description": "Where its files are, relative to the folder, with at most one placeholder: words/{stem}.md"
						},
						"fields": {
							"type": "object",
							"required": [
								"type"
							],
							"properties": {
								"type": {
									"type": "string",
									"const": "object"
								}
							},
							"additionalProperties": true,
							"description": "JSON Schema of each file's fields: its front matter"
						}
					},
					"additionalProperties": false
				}
			},
			"additionalProperties": false
		}
	},
	"$id": "https://epicenter.so/epicenter.schema.json",
	"title": "An Epicenter app",
	"additionalProperties": false
}
