{
	"about": "Storage calls and what each answers, run by core/src/storage_tests.rs over the desktop shell's storage and by packages/folder/src/storage-outcomes.test.ts over the Bun directory storage. `tree` is made under an empty root, beside a directory `../outside` holding `secret.md`. `links` maps a path to a symbolic link's target. `expected` is what a put expects at its path: `\"absent\"`, `\"present\"`, `\"any\"`, or `{ \"sha256Of\": text }` for a file whose bytes are that text. `expect` is the value (`text` for a read) or the error's name and path. `after` lists files and their text, and paths that must be absent. A case that `requires` `caseInsensitive` runs only on a disk that ignores case, one that requires `links` only where links can be made, and one that requires `nonportableNames` only where a name Windows refuses can be made.",
	"cases": [
		{
			"name": "a read answers a regular file's bytes",
			"tree": { "files": { "todos/a.md": "first" } },
			"call": { "method": "read", "path": "todos/a.md" },
			"expect": { "value": { "text": "first" } }
		},
		{
			"name": "a read of a directory is NotAFile",
			"tree": { "directories": ["todos"] },
			"call": { "method": "read", "path": "todos" },
			"expect": { "error": { "name": "NotAFile", "path": "todos" } }
		},
		{
			"name": "a read of nothing is NotFound",
			"tree": {},
			"call": { "method": "read", "path": "todos/a.md" },
			"expect": { "error": { "name": "NotFound", "path": "todos/a.md" } }
		},
		{
			"name": "a read below a file is NotFound",
			"tree": { "files": { "a.md": "a" } },
			"call": { "method": "read", "path": "a.md/b.md" },
			"expect": { "error": { "name": "NotFound", "path": "a.md/b.md" } }
		},
		{
			"name": "a read of a case-variant name is NotFound",
			"requires": "caseInsensitive",
			"tree": { "files": { "Todos/A.md": "theirs" } },
			"call": { "method": "read", "path": "Todos/a.md" },
			"expect": { "error": { "name": "NotFound", "path": "Todos/a.md" } }
		},
		{
			"name": "a read through a case-variant parent is NotFound",
			"requires": "caseInsensitive",
			"tree": { "files": { "Todos/A.md": "theirs" } },
			"call": { "method": "read", "path": "todos/A.md" },
			"expect": { "error": { "name": "NotFound", "path": "todos/A.md" } }
		},
		{
			"name": "a put onto a case-variant name is InvalidPath and changes nothing",
			"requires": "caseInsensitive",
			"tree": { "files": { "Todos/A.md": "theirs" } },
			"call": {
				"method": "put",
				"path": "Todos/a.md",
				"bytes": "mine",
				"expected": "absent"
			},
			"expect": {
				"error": {
					"name": "InvalidPath",
					"path": "Todos/a.md",
					"reason": "another entry occupies this name"
				}
			},
			"after": { "files": { "Todos/A.md": "theirs" } }
		},
		{
			"name": "a put through a case-variant parent is InvalidPath and changes nothing",
			"requires": "caseInsensitive",
			"tree": { "files": { "Todos/A.md": "theirs" } },
			"call": {
				"method": "put",
				"path": "todos/b.md",
				"bytes": "mine",
				"expected": "absent"
			},
			"expect": {
				"error": {
					"name": "InvalidPath",
					"path": "todos/b.md",
					"reason": "another entry occupies this name"
				}
			},
			"after": { "absent": ["Todos/b.md"] }
		},
		{
			"name": "a removal of a case-variant name is InvalidPath and changes nothing",
			"requires": "caseInsensitive",
			"tree": { "files": { "Todos/A.md": "theirs" } },
			"call": {
				"method": "put",
				"path": "Todos/a.md",
				"bytes": null,
				"expected": { "sha256Of": "theirs" }
			},
			"expect": {
				"error": {
					"name": "InvalidPath",
					"path": "Todos/a.md",
					"reason": "another entry occupies this name"
				}
			},
			"after": { "files": { "Todos/A.md": "theirs" } }
		},
		{
			"name": "a read through a link is InvalidPath",
			"requires": "links",
			"tree": { "links": { "todos": "../outside" } },
			"call": { "method": "read", "path": "todos/secret.md" },
			"expect": {
				"error": {
					"name": "InvalidPath",
					"path": "todos/secret.md",
					"reason": "the path passes through a symbolic link"
				}
			}
		},
		{
			"name": "a read of a link is InvalidPath",
			"requires": "links",
			"tree": { "links": { "a.md": "../outside/secret.md" } },
			"call": { "method": "read", "path": "a.md" },
			"expect": {
				"error": {
					"name": "InvalidPath",
					"path": "a.md",
					"reason": "the path passes through a symbolic link"
				}
			}
		},
		{
			"name": "a put through a link is InvalidPath and writes nothing there",
			"requires": "links",
			"tree": { "links": { "todos": "../outside" } },
			"call": {
				"method": "put",
				"path": "todos/new.md",
				"bytes": "mine",
				"expected": "absent"
			},
			"expect": {
				"error": {
					"name": "InvalidPath",
					"path": "todos/new.md",
					"reason": "the path passes through a symbolic link"
				}
			},
			"after": { "absent": ["../outside/new.md"] }
		},
		{
			"name": "a removal of a link is InvalidPath and keeps what it names",
			"requires": "links",
			"tree": { "links": { "a.md": "../outside/secret.md" } },
			"call": {
				"method": "put",
				"path": "a.md",
				"bytes": null,
				"expected": { "sha256Of": "secret" }
			},
			"expect": {
				"error": {
					"name": "InvalidPath",
					"path": "a.md",
					"reason": "the path passes through a symbolic link"
				}
			},
			"after": { "files": { "../outside/secret.md": "secret" } }
		},
		{
			"name": "a put onto a directory is NotAFile",
			"tree": { "directories": ["todos"] },
			"call": {
				"method": "put",
				"path": "todos",
				"bytes": "x",
				"expected": "absent"
			},
			"expect": { "error": { "name": "NotAFile", "path": "todos" } }
		},
		{
			"name": "a put below a file is NotADirectory, naming the file",
			"tree": { "files": { "a.md": "a" } },
			"call": {
				"method": "put",
				"path": "a.md/b/c.md",
				"bytes": "x",
				"expected": "absent"
			},
			"expect": { "error": { "name": "NotADirectory", "path": "a.md" } },
			"after": { "files": { "a.md": "a" } }
		},
		{
			"name": "a put into Git's private state is InvalidPath",
			"tree": {},
			"call": {
				"method": "put",
				"path": ".git/config",
				"bytes": "x",
				"expected": "absent"
			},
			"expect": {
				"error": {
					"name": "InvalidPath",
					"path": ".git/config",
					"reason": "the path is inside private Git state"
				}
			},
			"after": { "absent": [".git/config"] }
		},
		{
			"name": "a new file lands with its missing parents",
			"tree": {},
			"call": {
				"method": "put",
				"path": "new/deep/a.md",
				"bytes": "mine",
				"expected": "absent"
			},
			"expect": { "value": "landed" },
			"after": { "files": { "new/deep/a.md": "mine" } }
		},
		{
			"name": "a put expecting the bytes there lands",
			"tree": { "files": { "a.md": "old" } },
			"call": {
				"method": "put",
				"path": "a.md",
				"bytes": "new",
				"expected": { "sha256Of": "old" }
			},
			"expect": { "value": "landed" },
			"after": { "files": { "a.md": "new" } }
		},
		{
			"name": "a put expecting other bytes is stale and changes nothing",
			"tree": { "files": { "a.md": "old" } },
			"call": {
				"method": "put",
				"path": "a.md",
				"bytes": "new",
				"expected": { "sha256Of": "other" }
			},
			"expect": { "value": "stale" },
			"after": { "files": { "a.md": "old" } }
		},
		{
			"name": "a create where a file is is stale and changes nothing",
			"tree": { "files": { "a.md": "old" } },
			"call": {
				"method": "put",
				"path": "a.md",
				"bytes": "new",
				"expected": "absent"
			},
			"expect": { "value": "stale" },
			"after": { "files": { "a.md": "old" } }
		},
		{
			"name": "a stale put leaves no new directory",
			"tree": {},
			"call": {
				"method": "put",
				"path": "new/deep/a.md",
				"bytes": "new",
				"expected": { "sha256Of": "old" }
			},
			"expect": { "value": "stale" },
			"after": { "absent": ["new"] }
		},
		{
			"name": "a removal of nothing that expects nothing has landed",
			"tree": {},
			"call": {
				"method": "put",
				"path": "a.md",
				"bytes": null,
				"expected": "absent"
			},
			"expect": { "value": "landed" }
		},
		{
			"name": "a removal of nothing that expects a file is stale",
			"tree": {},
			"call": {
				"method": "put",
				"path": "a.md",
				"bytes": null,
				"expected": { "sha256Of": "old" }
			},
			"expect": { "value": "stale" }
		},
		{
			"name": "a removal expecting the bytes there lands",
			"tree": { "files": { "a.md": "old" } },
			"call": {
				"method": "put",
				"path": "a.md",
				"bytes": null,
				"expected": { "sha256Of": "old" }
			},
			"expect": { "value": "landed" },
			"after": { "absent": ["a.md"] }
		},
		{
			"name": "a removal expecting other bytes is stale and keeps the file",
			"tree": { "files": { "a.md": "old" } },
			"call": {
				"method": "put",
				"path": "a.md",
				"bytes": null,
				"expected": { "sha256Of": "other" }
			},
			"expect": { "value": "stale" },
			"after": { "files": { "a.md": "old" } }
		},
		{
			"name": "a removal expecting nothing where a file is is stale",
			"tree": { "files": { "a.md": "old" } },
			"call": {
				"method": "put",
				"path": "a.md",
				"bytes": null,
				"expected": "absent"
			},
			"expect": { "value": "stale" },
			"after": { "files": { "a.md": "old" } }
		},
		{
			"name": "an unconditional put replaces the file there",
			"tree": { "files": { "a.md": "old" } },
			"call": {
				"method": "put",
				"path": "a.md",
				"bytes": "new",
				"expected": "any"
			},
			"expect": { "value": "landed" },
			"after": { "files": { "a.md": "new" } }
		},
		{
			"name": "an unconditional put makes a new file with its parents",
			"tree": {},
			"call": {
				"method": "put",
				"path": "new/deep/a.md",
				"bytes": "new",
				"expected": "any"
			},
			"expect": { "value": "landed" },
			"after": { "files": { "new/deep/a.md": "new" } }
		},
		{
			"name": "a put expecting a file where none is is stale and makes nothing",
			"tree": {},
			"call": {
				"method": "put",
				"path": "new/a.md",
				"bytes": "new",
				"expected": "present"
			},
			"expect": { "value": "stale" },
			"after": { "absent": ["new"] }
		},
		{
			"name": "a put expecting a file lands over any file",
			"tree": { "files": { "a.md": "old" } },
			"call": {
				"method": "put",
				"path": "a.md",
				"bytes": "new",
				"expected": "present"
			},
			"expect": { "value": "landed" },
			"after": { "files": { "a.md": "new" } }
		},
		{
			"name": "an unconditional removal of nothing has landed",
			"tree": {},
			"call": {
				"method": "put",
				"path": "a.md",
				"bytes": null,
				"expected": "any"
			},
			"expect": { "value": "landed" }
		},
		{
			"name": "an unconditional removal removes the file",
			"tree": { "files": { "a.md": "old" } },
			"call": {
				"method": "put",
				"path": "a.md",
				"bytes": null,
				"expected": "any"
			},
			"expect": { "value": "landed" },
			"after": { "absent": ["a.md"] }
		},
		{
			"name": "a removal expecting a file removes it",
			"tree": { "files": { "a.md": "old" } },
			"call": {
				"method": "put",
				"path": "a.md",
				"bytes": null,
				"expected": "present"
			},
			"expect": { "value": "landed" },
			"after": { "absent": ["a.md"] }
		},
		{
			"name": "a removal expecting a file where none is is stale",
			"tree": {},
			"call": {
				"method": "put",
				"path": "a.md",
				"bytes": null,
				"expected": "present"
			},
			"expect": { "value": "stale" }
		},
		{
			"name": "an unconditional put onto a directory is NotAFile",
			"tree": { "directories": ["todos"] },
			"call": {
				"method": "put",
				"path": "todos",
				"bytes": "x",
				"expected": "any"
			},
			"expect": { "error": { "name": "NotAFile", "path": "todos" } }
		},
		{
			"name": "an unconditional put through a link is InvalidPath and writes nothing there",
			"requires": "links",
			"tree": { "links": { "todos": "../outside" } },
			"call": {
				"method": "put",
				"path": "todos/new.md",
				"bytes": "mine",
				"expected": "any"
			},
			"expect": {
				"error": {
					"name": "InvalidPath",
					"path": "todos/new.md",
					"reason": "the path passes through a symbolic link"
				}
			},
			"after": { "absent": ["../outside/new.md"] }
		},
		{
			"name": "an unconditional removal of a link is InvalidPath and keeps what it names",
			"requires": "links",
			"tree": { "links": { "a.md": "../outside/secret.md" } },
			"call": {
				"method": "put",
				"path": "a.md",
				"bytes": null,
				"expected": "any"
			},
			"expect": {
				"error": {
					"name": "InvalidPath",
					"path": "a.md",
					"reason": "the path passes through a symbolic link"
				}
			},
			"after": { "files": { "../outside/secret.md": "secret" } }
		},
		{
			"name": "an unconditional put into Git's private state is InvalidPath",
			"tree": {},
			"call": {
				"method": "put",
				"path": ".git/config",
				"bytes": "x",
				"expected": "any"
			},
			"expect": { "error": { "name": "InvalidPath", "path": ".git/config" } },
			"after": { "absent": [".git/config"] }
		},
		{
			"name": "an unconditional put replaces an existing nonportable name",
			"requires": "nonportableNames",
			"tree": { "files": { "todos/a?.md": "old" } },
			"call": {
				"method": "put",
				"path": "todos/a?.md",
				"bytes": "new",
				"expected": "any"
			},
			"expect": { "value": "landed" },
			"after": { "files": { "todos/a?.md": "new" } }
		},
		{
			"name": "an unconditional put cannot create a nonportable name",
			"requires": "nonportableNames",
			"tree": { "directories": ["todos"] },
			"call": {
				"method": "put",
				"path": "todos/b?.md",
				"bytes": "new",
				"expected": "any"
			},
			"expect": { "error": { "name": "InvalidPath", "path": "todos/b?.md" } },
			"after": { "absent": ["todos/b?.md"] }
		},
		{
			"name": "a create of a nonportable name is InvalidPath",
			"requires": "nonportableNames",
			"tree": { "directories": ["todos"] },
			"call": {
				"method": "put",
				"path": "todos/b?.md",
				"bytes": "new",
				"expected": "absent"
			},
			"expect": { "error": { "name": "InvalidPath", "path": "todos/b?.md" } },
			"after": { "absent": ["todos/b?.md"] }
		},
		{
			"name": "a put expecting an existing nonportable file lands",
			"requires": "nonportableNames",
			"tree": { "files": { "todos/a?.md": "old" } },
			"call": {
				"method": "put",
				"path": "todos/a?.md",
				"bytes": "new",
				"expected": "present"
			},
			"expect": { "value": "landed" },
			"after": { "files": { "todos/a?.md": "new" } }
		},
		{
			"name": "a put witnessing an existing nonportable file lands",
			"requires": "nonportableNames",
			"tree": { "files": { "todos/a?.md": "old" } },
			"call": {
				"method": "put",
				"path": "todos/a?.md",
				"bytes": "new",
				"expected": { "sha256Of": "old" }
			},
			"expect": { "value": "landed" },
			"after": { "files": { "todos/a?.md": "new" } }
		},
		{
			"name": "an unconditional removal of an existing nonportable name lands",
			"requires": "nonportableNames",
			"tree": { "files": { "todos/a?.md": "old" } },
			"call": {
				"method": "put",
				"path": "todos/a?.md",
				"bytes": null,
				"expected": "any"
			},
			"expect": { "value": "landed" },
			"after": { "absent": ["todos/a?.md"] }
		},
		{
			"name": "an existing HEAD segment is never replaced",
			"tree": { "files": { "todos/HEAD": "ref" } },
			"call": {
				"method": "put",
				"path": "todos/HEAD",
				"bytes": "new",
				"expected": "any"
			},
			"expect": { "error": { "name": "InvalidPath", "path": "todos/HEAD" } },
			"after": { "files": { "todos/HEAD": "ref" } }
		},
		{
			"name": "a listing leaves out .git and lists each file",
			"tree": {
				"files": { ".git/HEAD": "ref", "todos/a.md": "first" },
				"directories": ["empty"]
			},
			"call": { "method": "list" },
			"expect": { "value": [{ "path": "todos/a.md" }] }
		}
	]
}
