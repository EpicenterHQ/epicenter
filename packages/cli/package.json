{
	"name": "@epicenter/cli",
	"version": "0.5.0",
	"description": "The epicenter command: runs the apps of an Epicenter home as commands and as MCP tools. A home depends on it and runs it with Bun.",
	"repository": {
		"type": "git",
		"url": "https://github.com/EpicenterHQ/epicenter.git",
		"directory": "packages/cli"
	},
	"homepage": "https://epicenter.so",
	"type": "module",
	"bin": {
		"epicenter": "./src/bin.ts"
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test-support.ts"
	],
	"scripts": {
		"pack": "bun scripts/pack.ts",
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"@epicenter/app": "workspace:*",
		"@epicenter/theme": "workspace:*",
		"@modelcontextprotocol/sdk": "catalog:",
		"typebox": "catalog:",
		"wellcrafted": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"typescript": "catalog:"
	},
	"publishConfig": {
		"access": "public"
	},
	"license": "AGPL-3.0-or-later"
}
