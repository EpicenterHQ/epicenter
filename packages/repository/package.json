{
	"name": "@epicenter/repository",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./server": "./src/server/index.ts",
		"./wire": "./src/wire/index.ts",
		"./client": "./src/client/index.ts",
