{
	"name": "@epicenter/folder",
	"version": "0.0.1",
	"private": true,
	"description": "One local Folder: Markdown tables and ordinary files, opened as a browser origin's default folder, a directory bound to a Tauri window, or a directory in Bun.",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./browser": "./src/browser.ts",
		"./tauri": "./src/tauri.ts",
		"./bun": "./src/bun.ts",
		"./file-browser": "./src/file-browser.ts",
		"./declaration": "./src/declaration/index.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "bun test --isolate",
		"test:engine": "bun test --isolate src/browser/ src/shared/",
		"smoke:local": "bun smoke/local.ts",
		"smoke:sync:local": "bun smoke/sync.ts",
		"gen:vectors": "bun src/git/commit-subject-vectors.ts",
		"schema:generate": "bun src/declaration/generate-schema.ts"
	},
	"dependencies": {
		"@epicenter/definition": "workspace:*",
		"@tauri-apps/api": "catalog:",
		"buffer": "^6.0.3",
		"diff": "^8.0.4",
		"ignore": "^7.0.5",
		"isomorphic-git": "1.38.5",
		"typebox": "catalog:",
		"wellcrafted": "catalog:",
		"yaml": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"fake-indexeddb": "^6.2.6",
		"playwright": "^1.61.1",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"license": "AGPL-3.0-or-later"
}
