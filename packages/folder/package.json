{
	"name": "@epicenter/folder",
	"version": "0.0.1",
	"private": true,
	"description": "Open an app's files as its contract's typed client: in a browser origin, a directory in Bun or Tauri, or a hosted repository.",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./browser": "./src/browser.ts",
		"./tauri": "./src/tauri.ts",
		"./bun": "./src/bun.ts",
		"./node": "./src/node.ts",
		"./remote": "./src/remote.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server-tests.json",
		"test": "bun test --isolate",
		"smoke:device": "bun smoke/device.ts"
	},
	"dependencies": {
		"@epicenter/constants": "workspace:*",
		"@epicenter/definition": "workspace:*",
		"@tauri-apps/api": "catalog:",
		"wellcrafted": "catalog:"
	},
	"devDependencies": {
		"@epicenter/auth": "workspace:*",
		"@epicenter/server": "workspace:*",
		"@types/bun": "catalog:",
		"@types/pg": "^8.18.0",
		"drizzle-orm": "catalog:",
		"pg": "^8.20.0",
		"playwright": "^1.61.1",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"license": "AGPL-3.0-or-later"
}
