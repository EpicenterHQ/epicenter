{
	"name": "@epicenter/folder",
	"version": "0.0.1",
	"private": true,
	"description": "Open an app's folder at a place as its contract's collections: the desktop's data folder, this browser's storage, the account's repository, a directory in Bun, or memory under test.",
	"type": "module",
	"exports": {
		".": {
			"test": "./src/home.memory.ts",
			"default": "./src/home.ts"
		},
		"./core": "./src/core.ts",
		"./tauri": "./src/tauri.ts",
		"./bun": "./src/bun.ts",
		"./node": "./src/node.ts",
		"./memory": "./src/memory.ts",
		"./served": "./src/served.ts",
		"./serve": "./src/serve.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server-tests.json",
		"test": "bun test --isolate"
	},
	"dependencies": {
		"@epicenter/definition": "workspace:*",
		"@tauri-apps/api": "catalog:",
		"wellcrafted": "catalog:"
	},
	"devDependencies": {
		"@epicenter/account": "workspace:*",
		"@epicenter/server": "workspace:*",
		"@types/bun": "catalog:",
		"@types/pg": "^8.18.0",
		"drizzle-orm": "catalog:",
		"hono": "catalog:",
		"pg": "^8.20.0",
		"playwright": "^1.61.1",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"license": "AGPL-3.0-or-later"
}
