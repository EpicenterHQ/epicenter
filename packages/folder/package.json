{
	"name": "@epicenter/folder",
	"version": "0.0.1",
	"private": true,
	"description": "File-authoritative folders: Markdown tables, kv.json, ordinary files, and Git history, opened in a browser, in the Tauri desktop app, or over a directory in Bun.",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./browser": "./src/browser.ts",
		"./tauri": "./src/tauri.ts",
		"./bun": "./src/bun.ts",
		"./file-browser": "./src/file-browser.ts",
		"./query": "./src/query.ts",
		"./svelte": "./src/svelte/editor.svelte.ts"
	},
	"scripts": {
		"typecheck": "svelte-check --tsconfig ./tsconfig.json",
		"test": "bun test --isolate --path-ignore-patterns='src/svelte/**' && bun run test:svelte",
		"test:svelte": "bun test --isolate --conditions=browser src/svelte",
		"gen:vectors": "bun src/git/commit-subject-vectors.ts"
	},
	"dependencies": {
		"@epicenter/definition": "workspace:*",
		"@tauri-apps/api": "catalog:",
		"buffer": "^6.0.3",
		"diff": "^8.0.4",
		"ignore": "^7.0.5",
		"isomorphic-git": "1.38.5",
		"jsonc-parser": "^3.3.1",
		"nanoid": "catalog:",
		"typebox": "catalog:",
		"wellcrafted": "catalog:",
		"yaml": "catalog:"
	},
	"peerDependencies": {
		"@tanstack/query-core": "^5.82.0",
		"svelte": "^5.9.0"
	},
	"peerDependenciesMeta": {
		"@tanstack/query-core": {
			"optional": true
		},
		"svelte": {
			"optional": true
		}
	},
	"devDependencies": {
		"@tanstack/query-core": "catalog:",
		"@types/bun": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"jsdom": "26.1.0",
		"@types/jsdom": "21.1.7"
	},
	"license": "AGPL-3.0-or-later"
}
