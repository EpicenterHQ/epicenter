{
	"name": "@epicenter/app-shell",
	"version": "0.3.0",
	"private": true,
	"type": "module",
	"description": "Shared Epicenter app chrome: account popover, boot screens, inference picker, and agent chat. Branded, full-stack-aware UI mounted in each app's layout. Private (not published).",
	"keywords": [
		"svelte",
		"epicenter",
		"app-shell"
	],
	"exports": {
		"./departure": "./src/boot-screens/departure.ts",
		"./account-popover": "./src/account-popover/index.ts",
		"./agent-chat": "./src/agent-chat/index.ts",
		"./boot-screens": "./src/boot-screens/index.ts",
		"./inference-selections": "./src/inference-selections.ts",
		"./inference-picker": "./src/inference-picker/index.ts",
		"./persistence-notice": "./src/persistence-notice/index.ts"
	},
	"scripts": {
		"typecheck": "svelte-check --tsconfig ./tsconfig.json",
		"test": "bun test --isolate"
	},
	"dependencies": {
		"@epicenter/principal": "workspace:*",
		"nanoid": "catalog:",
		"@epicenter/agent": "workspace:*",
		"@epicenter/auth": "workspace:*",
		"@epicenter/chat": "workspace:*",
		"@epicenter/client": "workspace:*",
		"@epicenter/data": "workspace:*",
		"@epicenter/svelte": "workspace:*",
		"@epicenter/ui": "workspace:*",
		"@lucide/svelte": "catalog:",
		"@standard-schema/spec": "catalog:",
		"@tanstack/svelte-query": "catalog:",
		"@tauri-apps/api": "catalog:",
		"@y/y": "14.0.0-rc.24",
		"arktype": "catalog:",
		"wellcrafted": "catalog:",
		"@epicenter/app": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:",
		"openai": "^7.12.1"
	},
	"license": "AGPL-3.0-or-later"
}
