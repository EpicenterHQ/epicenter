{
	"name": "@epicenter/svelte",
	"version": "0.3.0",
	"private": true,
	"type": "module",
	"description": "Svelte 5 bindings for the folder mirror, text editing, repository source editing, agent conversations, and status.",
	"keywords": [
		"svelte",
		"local-first",
		"CRDT",
		"epicenter",
		"workspace",
		"reactive state"
	],
	"exports": {
		".": "./src/index.ts",
		"./folder": "./src/folder.ts",
		"./open-folder": "./src/open-folder.svelte",
		"./unsaved-edit": "./src/unsaved-edit.svelte",
		"./row-issues": "./src/row-issues.svelte",
		"./status-line": "./src/status-line.ts",
		"./status-popover": "./src/status-popover.svelte",
		"./status-row": "./src/status-row.svelte",
		"./codemirror": "./src/codemirror.ts",
		"./source-editor": "./src/source-editor.svelte",
		"./repository": "./src/repository/index.ts",
		"./repository/source-editor": "./src/repository/source-editor.svelte",
		"./repository/gate": "./src/repository/repository-gate.svelte"
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/merge": "^6.12.3",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@epicenter/agent": "workspace:*",
		"@epicenter/folder": "workspace:*",
		"@epicenter/repository": "workspace:*",
		"@epicenter/ui": "workspace:*",
		"@lucide/svelte": "catalog:",
		"@tauri-apps/api": "catalog:",
		"typebox": "catalog:",
		"wellcrafted": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"jsdom": "26.1.0",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:"
	},
	"scripts": {
		"typecheck": "svelte-check --tsconfig ./tsconfig.json",
		"test": "bun test --isolate --conditions=browser --conditions=svelte"
	},
	"license": "AGPL-3.0-or-later"
}
