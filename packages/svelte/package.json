{
	"name": "@epicenter/svelte",
	"version": "0.3.0",
	"private": true,
	"type": "module",
	"description": "Svelte 5 bindings for Epicenter: the folder app root, agent conversations, the sync review, and the header status.",
	"keywords": [
		"svelte",
		"local-first",
		"CRDT",
		"epicenter",
		"workspace",
		"reactive state"
	],
	"exports": {
		".": "./src/index.ts",
		"./edits": "./src/edits.svelte.ts",
		"./folder": "./src/folder-context.ts",
		"./folder-app": "./src/folder-app.svelte",
		"./folder-provider": "./src/folder-provider.svelte",
		"./status-line": "./src/status-line.ts",
		"./status-popover": "./src/status-popover.svelte",
		"./status-row": "./src/status-row.svelte",
		"./sync-line": "./src/sync-line.ts",
		"./write-failure": "./src/write-failure.ts"
	},
	"dependencies": {
		"@epicenter/agent": "workspace:*",
		"@epicenter/folder": "workspace:*",
		"@epicenter/ui": "workspace:*",
		"@lucide/svelte": "catalog:",
		"@tanstack/query-core": "catalog:",
		"@tanstack/svelte-query": "catalog:",
		"wellcrafted": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:"
	},
	"scripts": {
		"typecheck": "svelte-check --tsconfig ./tsconfig.json",
		"test": "bun test --isolate --conditions=browser --conditions=svelte"
	},
	"license": "AGPL-3.0-or-later"
}
