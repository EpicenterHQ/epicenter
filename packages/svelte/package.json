{
	"name": "@epicenter/svelte",
	"version": "0.3.0",
	"private": true,
	"type": "module",
	"description": "Svelte 5 bindings for Epicenter: reactive workspace state, persisted state, folder edit sessions, and the shared folder UI.",
	"keywords": [
		"svelte",
		"local-first",
		"CRDT",
		"epicenter",
		"workspace",
		"reactive state"
	],
	"exports": {
		".": "./src/index.ts",
		"./edit-session": "./src/edit-session.svelte.ts",
		"./folder-ui": "./src/folder-ui/index.ts",
		"./terminal-session": "./src/folder-ui/terminal-session.svelte.ts",
		"./open-item": "./src/open-item.svelte.ts",
		"./admissions": "./src/admissions.svelte.ts",
		"./closing": "./src/closing.svelte.ts",
		"./closing-notice": "./src/closing-notice.svelte",
		"./save-bar": "./src/save-bar.svelte",
		"./sync": "./src/sync.svelte.ts",
		"./sync-line": "./src/sync-line.ts",
		"./sync-review": "./src/sync-review.svelte"
	},
	"dependencies": {
		"@epicenter/agent": "workspace:*",
		"@epicenter/folder": "workspace:*",
		"@epicenter/ui": "workspace:*",
		"@lucide/svelte": "catalog:",
		"arktype": "catalog:",
		"wellcrafted": "catalog:"
	},
	"devDependencies": {
		"@standard-schema/spec": "catalog:",
		"@types/bun": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:"
	},
	"scripts": {
		"typecheck": "svelte-check --tsconfig ./tsconfig.json",
		"test": "bun test --isolate --conditions=browser --path-ignore-patterns='**/*.mounted.test.ts' && bun run test:mounted",
		"test:mounted": "bun test --conditions=browser --conditions=svelte mounted.test"
	},
	"license": "AGPL-3.0-or-later"
}
