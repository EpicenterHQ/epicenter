		"svelte",
		"local-first",
		"CRDT",
		"epicenter",
		"workspace",
		"reactive state"
	],
	"exports": {
		"./leave-guard": "./src/leave-guard.svelte",
		"./note-repair": "./src/note-repair.svelte",
		"./unsaved-edit": "./src/unsaved-edit.svelte",
		"./status-line": "./src/status-line.ts",
		"./status-popover": "./src/status-popover.svelte",
		"./status-row": "./src/status-row.svelte",
		"./folder-sync": "./src/folder-sync.svelte.ts",
		"./folder-sync-actions": "./src/folder-sync-actions.svelte",
		"./folder-onboarding": "./src/folder-onboarding.svelte",
		"./reactive": "./src/reactive.ts",
		"./when-open": "./src/when-open.svelte"
	},
	"dependencies": {
		"@epicenter/definition": "workspace:*",
		"@epicenter/folder": "workspace:*",
		"@epicenter/ui": "workspace:*",
		"@lucide/svelte": "catalog:",
		"@tauri-apps/api": "catalog:",
		"wellcrafted": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"jsdom": "26.1.0",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:"
	},
