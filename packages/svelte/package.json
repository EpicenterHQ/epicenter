{
	"name": "@epicenter/svelte",
	"version": "0.3.0",
	"private": true,
	"type": "module",
	"description": "Svelte 5 bindings for the folder mirror, text editing, agent conversations, and status.",
	"keywords": [
		"svelte",
		"local-first",
		"CRDT",
		"epicenter",
		"workspace",
		"reactive state"
	],
	"exports": {
		".": "./src/index.ts",
		"./client": "./src/client.ts",
		"./folder": "./src/folder.ts",
		"./open-folder": "./src/open-folder.svelte",
		"./unsaved-edit": "./src/unsaved-edit.svelte",
		"./row-issues": "./src/row-issues.svelte",
		"./status-line": "./src/status-line.ts",
		"./status-popover": "./src/status-popover.svelte",
		"./status-row": "./src/status-row.svelte"
	},
	"dependencies": {
		"@epicenter/agent": "workspace:*",
		"@epicenter/definition": "workspace:*",
		"@epicenter/folder": "workspace:*",
		"@epicenter/ui": "workspace:*",
		"@lucide/svelte": "catalog:",
		"@tauri-apps/api": "catalog:",
		"typebox": "catalog:",
		"wellcrafted": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"jsdom": "26.1.0",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:"
	},
	"scripts": {
		"typecheck": "svelte-check --tsconfig ./tsconfig.json",
		"test": "bun test --isolate --conditions=browser --conditions=svelte"
	},
	"license": "AGPL-3.0-or-later"
}
