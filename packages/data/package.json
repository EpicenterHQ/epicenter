{
	"name": "@epicenter/data",
	"version": "0.0.1",
	"private": true,
	"description": "The Epicenter store: one document per application, a synchronous surface, and the transport that carries it.",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./field": "./src/field/index.ts",
		"./definition": "./src/definition/index.ts",
		"./artifact": "./src/artifact/index.ts",
		"./artifact/format": "./src/artifact/format.ts",
		"./artifact/checkout": "./src/artifact/checkout.ts",
		"./direct": "./src/direct.ts",
		"./flush-on-hide": "./src/store/flush-on-hide.ts",
		"./memory": "./src/store/memory.ts",
		"./browser": "./src/store/browser.ts",
		"./sync": "./src/sync/index.ts"
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test-support.ts"
	],
	"license": "AGPL-3.0-or-later",
	"scripts": {
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.dom.json && tsc --noEmit -p evidence/browser/durable-store/tsconfig.json && tsc --noEmit -p evidence/browser/write-cost/tsconfig.json && tsc --noEmit -p evidence/browser/port-cost/tsconfig.json",
		"test": "bun test"
	},
	"dependencies": {
		"@epicenter/blobs": "workspace:*",
		"@epicenter/constants": "workspace:*",
		"@epicenter/device": "workspace:*",
		"@epicenter/principal": "workspace:*",
		"@epicenter/recorder": "workspace:*",
		"@epicenter/sqlite": "workspace:*",
		"@epicenter/sync": "workspace:*",
		"@y/y": "14.0.0-rc.24",
		"idb": "^8.0.3",
		"nanoid": "catalog:",
		"typebox": "catalog:",
		"wellcrafted": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"fake-indexeddb": "^6.2.5",
		"playwright": "^1.61.1",
		"typescript": "catalog:",
		"vite": "catalog:"
	}
}
