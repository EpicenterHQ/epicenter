{
	"name": "@epicenter/server",
	"version": "0.1.1",
	"private": true,
	"type": "module",
	"description": "Shared Hono server for apps/api on Cloudflare Workers and on Bun with Postgres.",
	"exports": {
		".": "./src/index.ts",
		"./bun": "./src/bun.ts",
		"./cloud-db": "./src/cloud-db.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit && tsc --noEmit -p workers/tsconfig.json",
		"test": "bun test src",
		"test:workers": "vitest run -c vitest.workers.config.ts"
	},
	"dependencies": {
		"@better-auth/cimd": "catalog:",
		"@better-auth/core": "catalog:",
		"@better-auth/drizzle-adapter": "catalog:",
		"@better-auth/oauth-provider": "catalog:",
		"@better-auth/passkey": "catalog:",
		"@epicenter/auth": "workspace:*",
		"@epicenter/blobs": "workspace:*",
		"@epicenter/constants": "workspace:*",
		"@epicenter/principal": "workspace:*",
		"@hono/standard-validator": "catalog:",
		"arktype": "catalog:",
		"aws4fetch": "catalog:",
		"better-auth": "catalog:",
		"drizzle-orm": "catalog:",
		"hono": "catalog:",
		"hono-openapi": "catalog:",
		"jose": "catalog:",
		"nanoid": "catalog:",
		"pg": "^8.20.0",
		"wellcrafted": "catalog:"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.20.3",
		"@cloudflare/workers-types": "^4.20260405.1",
		"@types/bun": "catalog:",
		"@types/pg": "^8.18.0",
		"isomorphic-git": "1.38.5",
		"miniflare": "^5.20260801.1-alpha",
		"typescript": "catalog:",
		"vitest": "^4.1.0"
	},
	"license": "AGPL-3.0-or-later"
}
