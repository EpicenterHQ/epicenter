{
	"name": "@epicenter/messages-app",
	"description": "Beeper conversations with drafts kept as Markdown notes on this device, served on this computer",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "NODE_ENV=production vite build",
		"start": "bun run build && bun scripts/serve.ts",
		"preview": "vite preview",
		"contract": "bun scripts/write-contract.ts",
		"prepare": "svelte-kit sync || echo ''",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "bun test --isolate --conditions=browser --conditions=svelte src scripts",
		"test:e2e": "playwright test -c playwright.config.ts"
	},
	"dependencies": {
		"@epicenter/cli": "workspace:*",
		"@epicenter/definition": "workspace:*",
		"@epicenter/folder": "workspace:*",
		"@epicenter/svelte": "workspace:*",
		"@epicenter/ui": "workspace:*",
		"@tanstack/svelte-query": "catalog:",
		"wellcrafted": "catalog:"
	},
	"devDependencies": {
		"@epicenter/vite-config": "workspace:*",
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@types/bun": "catalog:",
		"playwright": "^1.61.1",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"license": "AGPL-3.0-or-later"
}
