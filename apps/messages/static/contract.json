{
	"name": "messages",
	"description": "Messages: a Markdown note per outgoing reply, a draft or ready to send through Beeper. Conversations stay in Beeper.",
	"collections": {
		"replies": {
			"path": "replies/{id}.md",
			"fields": {
				"chatId": {
					"type": "string"
				},
				"chatTitle": {
					"type": "string"
				},
				"profile": {
					"type": "string"
				},
				"status": {
					"enum": ["draft", "ready"]
				}
			},
			"required": ["chatId", "profile", "status"]
		}
	}
}
