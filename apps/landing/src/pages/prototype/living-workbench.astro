		border-bottom: 0;
	}

	@media (max-width: 46rem) {
		.inner {
			padding: 3.25rem 1.15rem;
		}

		.opening .inner {
			padding-block: 4rem 3.25rem;
		}

		.scatter li {
			grid-template-columns: 1fr;
