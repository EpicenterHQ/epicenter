---
import { Badge } from '@epicenter/ui/badge';
import { Button } from '@epicenter/ui/button';
import * as Card from '@epicenter/ui/card';
import {
	ArrowRight as ArrowRightIcon,
	Check as CheckIcon,
} from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const tools = [
	{
		emoji: '🎙️',
		name: 'Whispering',
		description:
			'Fast, minimal transcription that works with local and cloud models',
		features: [
			'Choose your provider',
			'Record and transcribe',
			'Copy your transcript',
		],
		githubUrl:
			'https://github.com/EpicenterHQ/epicenter/tree/main/apps/whispering',
		tryNowUrl: 'https://whispering.epicenter.so',
	},
	{
		emoji: '💻',
		name: 'epicenter.sh',
		description: 'Talk to your codebase from anywhere using your own hardware',
		features: [
			'Local OpenCode instance',
			'Secure tunneling',
			'Query from any device',
		],
		githubUrl:
			'https://github.com/EpicenterHQ/epicenter/tree/rebuild-assistant',
		tryNowUrl: 'https://epicenter.sh',
	},
];
---

<BaseLayout
	title="Epicenter: Make software that’s unmistakably yours"
	description="Keep your data in Markdown and SQLite files you own. Use our apps, someone else’s, or build your own."
>
	<main class="bg-background">
		<!-- Hero Section -->
		<header class="relative h-screen flex items-center justify-center">
			<!-- Subtle gradient background -->
			<div
				class="absolute inset-0 bg-gradient-to-b from-primary/5 via-background to-background -z-10"
			></div>

			<div class="w-full max-w-6xl mx-auto px-6 sm:px-8 md:px-12 text-center">
				<div>
					<!-- Main headline -->
					<h1
						class="text-4xl md:text-5xl font-bold text-foreground tracking-tight leading-snug md:leading-snug mb-8"
					>
						Make software that’s unmistakably yours.
					</h1>

					<!-- Subheadline -->
					<p
						class="text-lg md:text-xl text-muted-foreground max-w-2xl mx-auto leading-relaxed mb-12"
					>
						Keep your data in Markdown and SQLite files you own. Use our apps,
						someone else’s, or build your own.
					</p>

					<!-- CTAs -->
					<div class="flex flex-col sm:flex-row gap-4 justify-center mb-16">
						<Button
							href="https://github.com/EpicenterHQ/epicenter"
							size="lg"
							class="font-medium"
						>
							Star on GitHub
							<ArrowRightIcon class="w-4 h-4" />
						</Button>
						<Button
							href="https://go.epicenter.so/discord"
							variant="outline"
							size="lg"
							class="font-medium"
						>
							Join the Discord
						</Button>
					</div>

					<!-- Quick value props -->
					<div class="flex flex-wrap gap-x-8 gap-y-4 justify-center text-sm">
						<div class="flex items-center gap-2 text-muted-foreground">
							<CheckIcon class="w-4 h-4 text-success shrink-0" />
							<span>100% open source</span>
						</div>
						<div class="flex items-center gap-2 text-muted-foreground">
							<CheckIcon class="w-4 h-4 text-success shrink-0" />
							<span>Local-first</span>
						</div>
						<div class="flex items-center gap-2 text-muted-foreground">
							<CheckIcon class="w-4 h-4 text-success shrink-0" />
							<span>Personal software</span>
						</div>
					</div>
				</div>
			</div>
		</header>

		<!-- Product Showcase -->
		<section
			class="py-24 md:py-32 bg-gradient-to-b from-muted/10 via-muted/20 to-muted/10"
		>
			<div class="max-w-7xl mx-auto px-6">
				<div class="text-center mb-20">
					<Badge variant="secondary" class="mb-6 px-4 py-1 text-sm"
						>Available now</Badge
					>
					<h2 class="text-3xl md:text-5xl font-bold text-foreground mb-6">
						Apps built on Epicenter
					</h2>
					<p
						class="text-xl text-muted-foreground max-w-3xl mx-auto leading-relaxed"
					>
						Start with an app that does something useful for you. Explore its
						source, change how it works, and make it fit your workflow.
					</p>
				</div>

				<div class="grid lg:grid-cols-2 gap-8">
					{tools.map((tool) => (
							<Card.Root class="group overflow-hidden border-muted/50 shadow-sm transition-all duration-300 hover:border-primary/20 hover:shadow-xl">
								<Card.Header class="pb-4">
									<div class="flex items-start justify-between">
										<div class="flex items-start gap-4">
											<div class="text-5xl transition-transform duration-300 group-hover:scale-110">
												{tool.emoji}
											</div>
											<div>
												<Card.Title class="mb-2 text-2xl">
													{tool.name}
												</Card.Title>
												<Card.Description class="text-base">
													{tool.description}
												</Card.Description>
											</div>
										</div>
									</div>
								</Card.Header>
								<Card.Content class="py-6">
									<ul class="space-y-3">
										{tool.features.map((feature) => (
											<li class="flex items-center gap-3 text-sm">
												<div class="shrink-0 rounded-full bg-success/10 p-1">
													<CheckIcon class="h-3 w-3 text-success" />
												</div>
												<span class="text-muted-foreground transition-colors group-hover:text-foreground">
													{feature}
												</span>
											</li>
										))}
									</ul>
								</Card.Content>
								<Card.Footer class="border-muted/50 border-t pt-4">
									<div class="flex gap-2">
										<Button
											href={tool.tryNowUrl}
											variant="secondary"
											class="flex-1 transition-all hover:border-primary hover:bg-primary hover:text-primary-foreground group-hover:border-primary group-hover:bg-primary group-hover:text-primary-foreground"
										>
											Try Now
											<ArrowRightIcon class="h-4 w-4 transition-transform group-hover:translate-x-1" />
										</Button>
										<Button
											href={tool.githubUrl}
											variant="outline"
											class="flex-1"
										>
											View on GitHub
										</Button>
									</div>
								</Card.Footer>
							</Card.Root>
						))}
				</div>

				<div class="mt-16 text-center">
					<p class="text-muted-foreground mb-6 text-lg">
						More tools coming soon
					</p>
					<Button
						href="https://go.epicenter.so/discord"
						variant="secondary"
						size="lg"
						class="shadow-sm hover:shadow-md transition-all"
					>
						Join the community
						<ArrowRightIcon class="w-4 h-4" />
					</Button>
				</div>
			</div>
		</section>

		<!-- Product direction -->
		<section class="py-24 md:py-32">
			<div class="max-w-4xl mx-auto px-6">
				<Badge variant="secondary" class="mb-6">What we're building</Badge>
				<h2 class="text-3xl md:text-5xl font-bold text-foreground mb-6">
					Change your apps. Keep your data.
				</h2>
				<div class="space-y-6 text-lg text-muted-foreground leading-relaxed">
					<p>
						A coding agent can help you make a tool for your own workflow. We’re
						building the foundation that lets you redesign or replace that tool
						while keeping the files you’ve saved.
					</p>
					<p>
						Compatible apps will be able to work with the same data folder.
						Publishing an app will let other people use it with their own data.
						Your files stay yours when you change the software around them.
					</p>
					<p>
						Hosted personal homes, free app addresses, and custom domains are
						planned. They aren’t available yet. Publishing an app won’t make its
						users’ data public.
					</p>
				</div>
				<Button
					href="https://github.com/EpicenterHQ/epicenter"
					variant="outline"
					class="mt-8"
				>
					Follow the development
					<ArrowRightIcon class="w-4 h-4" />
				</Button>
			</div>
		</section>

		<!-- Footer -->
		<footer class="py-16 border-t border-muted/50">
			<div class="max-w-7xl mx-auto px-6">
				<div
					class="flex flex-col md:flex-row justify-between items-center gap-6"
				>
					<div class="text-sm text-muted-foreground">
						© {new Date().getFullYear()} Epicenter. Open source under AGPL-3.0
						license.
					</div>
					<div class="flex gap-8 text-sm">
						<a
							href="https://github.com/EpicenterHQ/epicenter"
							class="text-muted-foreground hover:text-foreground transition-colors font-medium"
						>
							GitHub
						</a>
						<a
							href="https://go.epicenter.so/discord"
							class="text-muted-foreground hover:text-foreground transition-colors font-medium"
						>
							Discord
						</a>
						<a
							href="/blog"
							class="text-muted-foreground hover:text-foreground transition-colors font-medium"
						>
							Blog
						</a>
					</div>
				</div>
			</div>
		</footer>
	</main>
</BaseLayout>

<style>
	/* Smooth animations */
	@keyframes fade-in {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes fade-in-scale {
		from {
			opacity: 0;
			transform: scale(0.95);
		}
		to {
			opacity: 1;
			transform: scale(1);
		}
	}

	header > div > div > * {
		animation: fade-in 0.8s ease-out forwards;
		opacity: 0;
	}

	header h1 {
		animation-delay: 0ms;
	}
	header p {
		animation-delay: 100ms;
	}
	header > div > div > div:nth-of-type(1) {
		animation-delay: 200ms;
	}
	header > div > div > div:nth-of-type(2) {
		animation-delay: 300ms;
	}

	/* Smooth scroll behavior */
	@media (prefers-reduced-motion: no-preference) {
		html {
			scroll-behavior: smooth;
		}
	}

	/* Success color for checkmarks */
	.text-success {
		color: hsl(142, 71%, 45%);
	}

	/* Better focus states */
	:focus-visible {
		outline: 2px solid hsl(var(--primary));
		outline-offset: 2px;
	}

	/* Animate sections on scroll */
	section {
		animation: fade-in-scale 0.6s ease-out;
	}
</style>
