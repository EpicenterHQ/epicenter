---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import {
	ADRS,
	adrUrl,
	CANONICAL_HOME,
	DISCORD,
	formatDay,
	GITHUB_REPO,
	LATEST_RELEASE,
	LEDGER_CHECKED_ON,
	WHISPERING_APP,
} from '../lib/site';

const home = CANONICAL_HOME.replace(/^https:\/\//, '');

const articles = (await getCollection('writing')).sort((a, b) =>
	b.data.writtenOn.localeCompare(a.data.writtenOn),
);
/** The piece that states the principle the whole project is built on. */
const featured =
	articles.find((article) => article.id === 'hello-world') ?? articles[0];
const rest = articles.filter((article) => article.id !== featured?.id);

/**
 * Where one thought currently lives. Invented, and labelled as such, because
 * the point is recognition rather than evidence: a reader who has done this
 * knows the shape of it, and a fabricated screenshot of a real product would be
 * the exact dishonesty this site is trying to avoid.
 */
const scatter = [
	['Notes.app', '2024-03-11', 'the paragraph you liked, never found again'],
	['Google Docs', '2024-08-02', 'the same paragraph, edited by someone else'],
	['a DM', '2025-01-19', 'the sentence you actually got right'],
	['a draft', '2025-06-30', '900 words, unpublished'],
	['NOTES.md', '2026-02-14', 'three bullets and a TODO'],
] as const;

/**
 * What a stranger is allowed to believe. `state` is spelled out in words
 * everywhere it appears; the mark beside it is a second cue, never the only
 * one, so the ledger survives being read in greyscale or read aloud.
 */
type LedgerEntry = {
	/** A second cue beside the words, never the only one. */
	readonly mark: '●' | '◐' | '○';
	readonly state: 'Ships today' | 'In the repository' | 'Decided, not built';
	readonly name: string;
	readonly detail: string;
	readonly href?: string;
	readonly hrefLabel?: string;
};

const ledger: readonly LedgerEntry[] = [
	{
		mark: '●',
		state: 'Ships today',
		name: 'Whispering',
		detail: `Transcription for the desktop and the browser, using your own API key or a model on your own machine. ${LATEST_RELEASE.version}, released ${formatDay(LATEST_RELEASE.releasedOn)}.`,
		href: WHISPERING_APP,
		hrefLabel: 'whispering.epicenter.so',
	},
	{
		mark: '●',
		state: 'Ships today',
		name: 'Sync for Whispering',
		detail:
			'The hosted server that keeps Whispering in step across your devices. It reads your data in plaintext; see below.',
	},
	{
		mark: '◐',
		state: 'In the repository',
		name: 'Epicenter desktop',
		detail:
			'The host that runs trusted apps in one window and owns recording, transcription, and the SQL console. Buildable from source, not released.',
	},
	{
		mark: '◐',
		state: 'In the repository',
		name: '@epicenter/app',
		detail:
			'The MIT client an outside app installs to reach the host. Written and tested, not yet published to npm.',
	},
	{
		mark: '○',
		state: 'Decided, not built',
		name: 'One Epicenter per person',
		detail:
			'Rows, documents, blobs, and Lenses: the storage model this page describes. Written down as proposals and being built against.',
	},
];
---

<PageLayout
	title="Epicenter — one place your work lives, that you can take with you"
	description="An open-source attempt at giving one person's notes, recordings, and writing a single home they can carry away whole. Built in public, honest about what runs today."
>
	<!-- ── 1. The recognition ─────────────────────────────────────────── -->
	<section class="band opening" id="top">
		<div class="inner">
			<h1 class="title-xl">You have already written this down four times.</h1>
			<div class="measure lede">
				<p class="read-lead">
					Once in a note, once in a doc somebody else edited, once in a message
					you can't find, once in a draft you never posted. Every copy is a
					little different and none of them is the one you would point at.
				</p>
				<p class="read">
					Epicenter is an attempt to give one person's work a single place to
					live: private by default, readable by whatever app you like, and yours
					to carry away whole. It is open source, and it is early.
				</p>
			</div>

			<div class="actions">
				<a class="action" href={GITHUB_REPO} rel="noreferrer"
					>Follow on GitHub</a
				>
				<a class="action action-quiet" href="/writing/">Read the writing</a>
			</div>

			<p class="caveat">
				There is no Epicenter to download yet.
				<a class="link" href="/whispering/">Whispering</a>, the first app on the
				way there, ships today.
			</p>
		</div>
	</section>

	<!-- ── 2. The scene ────────────────────────────────────────────────── -->
	<section class="band sunk" id="situation">
		<div class="inner">
			<p class="eyebrow">The situation</p>
			<h2 class="title-lg measure-wide">
				Nothing is lost, exactly. It is just in five places, and no place is in
				charge.
			</h2>

			<figure class="figure">
				<figcaption class="figure-cap">
					One idea, as currently stored
				</figcaption>
				<ul class="scatter">
					{scatter.map(([where, when, what]) => (
							<li>
								<span class="scatter-where">{where}</span>
								<span class="scatter-when">{when}</span>
								<span class="scatter-what">{what}</span>
							</li>
						))}
				</ul>
				<p class="figure-note">Illustration, not a screenshot.</p>
			</figure>

			<div class="measure after-figure">
				<p class="read">
					Each of those apps is fine. The problem is that each one wants to be
					the place your work lives, so your work ends up living in all of them
					and belonging to none. Search doesn't cross the gaps. Neither does
					anything you'd want to build on top.
				</p>
			</div>
		</div>
	</section>

	<!-- ── 3. The refusal ──────────────────────────────────────────────── -->
	<section class="band" id="idea">
		<div class="inner">
			<p class="eyebrow">The idea</p>
			<h2 class="title-lg measure-wide">
				The wrong fix is a sixth app to move into.
			</h2>

			<div class="measure after-head">
				<p class="read">
					So Epicenter inverts which part is permanent. Your data is the thing
					that persists. Apps are views onto it, and you should be able to throw
					one away without losing a sentence.
				</p>
			</div>

			<dl class="claims measure-wide">
				<div>
					<dt class="title-md">One Epicenter per person</dt>
					<dd class="read">
						Not one per app and not one per device. The same body of work on
						every machine you sign into, and it works offline before it works
						anywhere else.
					</dd>
				</div>
				<div>
					<dt class="title-md">Apps are replaceable</dt>
					<dd class="read">
						An app reaches your data through a small typed contract and gets no
						private storage of its own. Two apps can read the same things and
						neither one owns them.
					</dd>
				</div>
				<div>
					<dt class="title-md">You can take the whole thing</dt>
					<dd class="read">
						Not an export button that produces a zip of JSON you'll never open.
						One database file plus your original media, with no account and no
						server identity inside it.
					</dd>
				</div>
			</dl>
		</div>
	</section>

	<!-- ── 4. The shape ────────────────────────────────────────────────── -->
	<section class="band sunk" id="how-it-works">
		<div class="inner">
			<p class="eyebrow">How it works</p>
			<h2 class="title-lg measure-wide">
				Underneath, it is a boring thing you can open with ordinary tools.
			</h2>

			<figure class="figure">
				<figcaption class="figure-cap">One row</figcaption>
				<pre class="artifact">{`so.epicenter.whispering / recordings / 019f96c1…

  fields     what the app defined      { title, transcript, createdAt }
  document   a live collaborative doc  optional, at most one
  blob       the original bytes        optional, at most one, write-once`}</pre>
			</figure>

			<div class="measure after-figure">
				<p class="read">
					Everything you keep is a row at a durable address. A row owns its
					plain fields, at most one collaborative document, and at most one
					immutable file: the audio you recorded, the image you dropped in. An
					app declares a <em>Lens</em>, a plain-JSON description of the tables
					and values it understands, and reads through that. The Lens is an
					interpretation, never the schema of record, which is what lets two
					apps disagree about the same row without corrupting it.
				</p>
				<p class="read">
					The store itself is SQLite plus ordinary files on disk. Epicenter's
					own shell can open a read-only SQL console over it, so you can ask
					your data a question no app thought to offer. Applications never get
					that connection, which is how the private layout stays free to change
					without breaking anything you rely on.
				</p>
				<p class="read">
					Deleting is real. A deleted row leaves a permanent tombstone rather
					than simply going missing, so a laptop that was offline for a month
					can't quietly bring it back when it wakes up.
				</p>
			</div>

			<p class="records measure-wide">
				The long versions, with the arguments and the rejected alternatives:
				<a class="link" href={adrUrl(ADRS.oneEpicenter)} rel="noreferrer"
					>one Epicenter per person</a
				> <span class="stamp">{ADRS.oneEpicenter.status}</span>,
				<a class="link" href={adrUrl(ADRS.lenses)} rel="noreferrer">Lenses</a>
				<span class="stamp">{ADRS.lenses.status}</span>,
				<a class="link" href={adrUrl(ADRS.blobs)} rel="noreferrer"
					>one write-once file per row</a
				> <span class="stamp">{ADRS.blobs.status}</span>,
				<a class="link" href={adrUrl(ADRS.portable)} rel="noreferrer"
					>taking it with you</a
				> <span class="stamp">{ADRS.portable.status}</span>,
				<a class="link" href={adrUrl(ADRS.inspection)} rel="noreferrer"
					>the SQL console</a
				> <span class="stamp">{ADRS.inspection.status}</span>.
			</p>
		</div>
	</section>

	<!-- ── 5. The trust boundary ───────────────────────────────────────── -->
	<section class="band" id="where-your-data-is">
		<div class="inner">
			<p class="eyebrow">Where your data actually is</p>
			<h2 class="title-lg measure-wide">
				If you sign in, a server we run holds a readable copy. We are not going
				to pretend otherwise.
			</h2>

			<div class="measure after-head">
				<p class="read">
					Everything starts on your machine and works with the network off. Sign
					in and a server holds a copy too, so a phone that was asleep can catch
					up. That server reads your data in plaintext.
				</p>
				<p class="read">
					Epicenter had an encryption layer and removed it. Encrypting
					everything end to end also meant no server-side search and no
					assistant that could see anything, and shipping a promise we would
					have quietly broken later seemed worse than saying this plainly now.
				</p>
				<p class="read">
					So privacy here is a question of whose machine is holding your work,
					not which switch is flipped in a settings pane. Don't enable Epicenter
					sync and Epicenter receives no copy. Individual tools may still send
					only what you deliberately give them to a service you choose, such as
					audio sent to a cloud transcription provider. Run the sync server
					yourself and its readable copy stays on infrastructure you control.
					Use ours and you are trusting us the way you already trust every other
					company you sync with, except that you can read the code and leave
					with your data.
				</p>
			</div>

			<p class="records measure-wide">
				<a class="link" href={adrUrl(ADRS.plaintextRelay)} rel="noreferrer"
					>Why zero-knowledge was rejected</a
				> <span class="stamp">{ADRS.plaintextRelay.status}</span>,
				<a class="link" href={adrUrl(ADRS.privacyIsDeployment)} rel="noreferrer"
					>privacy is a deployment, not a feature</a
				> <span class="stamp">{ADRS.privacyIsDeployment.status}</span>.
			</p>
		</div>
	</section>

	<!-- ── 6. The demonstration ────────────────────────────────────────── -->
	<section class="band sunk" id="writing">
		<div class="inner">
			<p class="eyebrow">The reason any of this exists</p>
			<h2 class="title-lg measure-wide">
				One piece of writing, kept once, sent out in several complete forms.
			</h2>

			<div class="measure after-head">
				<p class="read">
					This is the workflow the software is meant to make ordinary, and
					Braden already lives it: a piece is written once and stays one work,
					then goes out as prose, as a recording, and as a short video, with the
					original staying canonical wherever it changes.
				</p>
				<p class="read">
					It does not run <em>on</em> Epicenter. It runs on a pile of scripts
					and a lot of stubbornness, because the general software does not exist
					yet. That gap is the project. The articles are the real output.
				</p>
			</div>

			{featured && (
					<div class="featured">
						<a class="featured-link" href={`/writing/${featured.id}/`}>
							<p class="eyebrow">Start here</p>
							<h3 class="title-lg featured-title">{featured.data.title}</h3>
							{featured.data.subtitle && (
								<p class="read featured-sub">{featured.data.subtitle}</p>
							)}
						</a>
						<p class="featured-meta">
							<time datetime={featured.data.writtenOn}>
								{formatDay(featured.data.writtenOn)}
							</time>
							<span aria-hidden="true"> · </span>
							<span>
								{[
									'Read',
									featured.data.narrationUrl && 'Listen',
									featured.data.video && 'Watch',
								]
									.filter(Boolean)
									.join(' / ')}
							</span>
						</p>
					</div>
				)}

			{rest.length > 0 && (
					<ul class="also">
						{rest.map((article) => (
							<li>
								<a class="link" href={`/writing/${article.id}/`}>
									{article.data.title}
								</a>
							</li>
						))}
					</ul>
				)}

			<p class="records measure-wide">
				Every one of these is republished in full from
				<a class="link" href={CANONICAL_HOME}>{home}</a>, which stays the
				canonical home.
			</p>
		</div>
	</section>

	<!-- ── 7. What runs today ──────────────────────────────────────────── -->
	<section class="band" id="status">
		<div class="inner">
			<p class="eyebrow">Status</p>
			<h2 class="title-lg measure-wide">What actually runs today</h2>

			<div class="measure after-head">
				<p class="read">
					Most of this page describes a system being built. Here is the part
					that would survive an audit.
				</p>
			</div>

			<ul class="ledger measure-wide">
				{ledger.map((item) => (
						<li class="ledger-row">
							<p class="ledger-state">
								<span class="ledger-mark" aria-hidden="true">
									{item.mark}
								</span>
								{item.state}
							</p>
							<div class="ledger-body">
								<h3 class="title-md">{item.name}</h3>
								<p class="read ledger-detail">
									{item.detail}
									{item.href && (
										<>
											{' '}
											<a class="link" href={item.href} rel="noreferrer">
												{item.hrefLabel}
											</a>
										</>
									)}
								</p>
							</div>
						</li>
					))}
			</ul>

			<p class="records measure-wide">
				Checked against the repository on {formatDay(LEDGER_CHECKED_ON)}. Public
				releases are
				<a class="link" href={LATEST_RELEASE.url} rel="noreferrer"
					>on GitHub</a
				>, and they are Whispering releases.
			</p>
		</div>
	</section>

	<!-- ── 8. Why open source, and the close ───────────────────────────── -->
	<section class="band sunk closing" id="open-source">
		<div class="inner">
			<p class="eyebrow">Why it is open</p>
			<h2 class="title-lg measure-wide">
				A promise you can't check isn't a promise.
			</h2>

			<div class="measure after-head">
				<p class="read">
					Every claim on this page is the kind you can go verify. The
					applications and the sync server are AGPL. The packages an outside app
					installs are MIT, so building on Epicenter doesn't drag a licence into
					your project. The decisions are dated records in the repository,
					including the ones that were reversed and the alternatives that lost.
				</p>
				<p class="read">
					This is not open source as a pricing tier. If Epicenter stops being
					worth using, both the code and your data outlive it, and that is the
					only version of this worth building.
				</p>
			</div>

			<div class="actions closing-actions">
				<a class="action" href={GITHUB_REPO} rel="noreferrer"
					>Follow on GitHub</a
				>
				<a class="action action-quiet" href={DISCORD} rel="noreferrer"
					>Discord</a
				>
				<a class="action action-quiet" href="/whispering/">Try Whispering</a>
			</div>
		</div>
	</section>
</PageLayout>

<style>
	.band {
		border-bottom: 1px solid var(--rule);
	}

	.band.sunk {
		background: var(--paper-sunk);
	}

	.inner {
		max-width: 62rem;
		margin-inline: auto;
		padding: 4.5rem 1.5rem;
	}

	/* ── Opening ── */
	.opening .inner {
		padding-block: 6rem 5rem;
	}

	.opening .title-xl {
		max-width: 20ch;
	}

	.lede {
		margin-top: 1.75rem;
	}

	.lede .read {
		margin-top: 1.15rem;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 1rem 2rem;
		margin-top: 2.5rem;
	}

	.caveat {
		margin-top: 2.25rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--rule);
		max-width: 34rem;
		font-size: 0.875rem;
		line-height: 1.55;
		color: var(--ink-faint);
	}

	/* ── Section heads ── */
	.eyebrow + .title-lg {
		margin-top: 0.9rem;
	}

	.after-head {
		margin-top: 1.5rem;
	}

	.after-head .read + .read,
	.measure .read + .read {
		margin-top: 1.05rem;
	}

	/* ── Figures ── */
	.figure {
		margin-top: 2.25rem;
		max-width: 46rem;
		border: 1px solid var(--rule);
		border-radius: 4px;
		background: var(--paper);
		overflow: hidden;
	}

	.figure-cap {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.11em;
		text-transform: uppercase;
		color: var(--ink-faint);
		padding: 0.7rem 1.1rem;
		border-bottom: 1px solid var(--rule);
	}

	.scatter {
		list-style: none;
		margin: 0;
		padding: 0.4rem 0;
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		line-height: 1.5;
	}

	.scatter li {
		display: grid;
		grid-template-columns: 8.5rem 6.5rem 1fr;
		gap: 0.75rem;
		padding: 0.55rem 1.1rem;
	}

	.scatter li + li {
		border-top: 1px solid color-mix(in oklch, var(--rule) 60%, transparent);
	}

	.scatter-where {
		color: var(--ink);
	}

	.scatter-when {
		color: var(--ink-faint);
	}

	.scatter-what {
		color: var(--ink-muted);
	}

	.figure-note {
		padding: 0.7rem 1.1rem;
		border-top: 1px solid var(--rule);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.06em;
		color: var(--ink-faint);
	}

	.artifact {
		margin: 0;
		padding: 1.1rem;
		overflow-x: auto;
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		line-height: 1.75;
		color: var(--ink-muted);
		white-space: pre;
		scrollbar-width: thin;
	}

	.after-figure {
		margin-top: 2rem;
	}

	/* ── Claims ── */
	.claims {
		margin-top: 2.5rem;
		display: grid;
		gap: 2rem;
	}

	.claims dd {
		margin: 0.5rem 0 0;
		max-width: 34rem;
	}

	/* ── Record links ── */
	.records {
		margin-top: 2.25rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--rule);
		font-size: 0.875rem;
		line-height: 1.8;
		color: var(--ink-muted);
	}

	.stamp {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-faint);
		border: 1px solid var(--rule-strong);
		border-radius: 2px;
		padding: 0.05rem 0.3rem;
		white-space: nowrap;
	}

	/* ── Featured article ── */
	.featured {
		margin-top: 2.5rem;
		max-width: 40rem;
		padding: 1.75rem;
		border: 1px solid var(--rule-strong);
		border-radius: 4px;
		background: var(--paper);
	}

	.featured-link {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.featured-title {
		margin-top: 0.6rem;
	}

	.featured-link:hover .featured-title {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.16em;
	}

	.featured-sub {
		margin-top: 0.6rem;
	}

	.featured-meta {
		margin-top: 1.1rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.also {
		margin-top: 1.5rem;
		padding: 0;
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		font-size: 0.9375rem;
		color: var(--ink-muted);
	}

	/* ── Ledger ── */
	.ledger {
		margin-top: 2.25rem;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--rule);
	}

	.ledger-row {
		display: grid;
		grid-template-columns: 12rem 1fr;
		gap: 1.5rem;
		padding-block: 1.5rem;
		border-bottom: 1px solid var(--rule);
	}

	.ledger-state {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.ledger-mark {
		font-size: 0.75rem;
		line-height: 1;
		color: var(--ink-muted);
	}

	.ledger-detail {
		margin-top: 0.4rem;
		max-width: 34rem;
	}

	/* ── Closing ── */
	.closing {
		border-bottom: 0;
