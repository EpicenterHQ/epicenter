{
	"name": "honeycrisp",
	"description": "Markdown notes: a note per file, its title, folder, pin and creation time in front matter, its text in the body; folders are notes of their own that notes name by id.",
	"collections": {
		"notes": {
			"path": "notes/{id}.md",
			"fields": {
				"title": {
					"type": "string"
				},
				"folderId": {
					"type": "string"
				},
				"pinned": {
					"type": "boolean"
				},
				"createdAt": {
					"type": "string",
					"format": "date-time"
				}
			},
			"required": ["createdAt"]
		},
		"folders": {
			"path": "folders/{id}.md",
			"fields": {
				"name": {
					"type": "string"
				},
				"icon": {
					"type": "string"
				}
			},
			"required": ["name"]
		}
	}
}
