{
	// Typechecks the `#platform/*` epicenter-host condition. `tsconfig.json`
	// resolves the default (browser) impls, so the host-served platform files
	// are only checked when the resolver is flipped here. `bun run typecheck`
	// runs both.
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"customConditions": ["epicenter-host"]
	}
}
