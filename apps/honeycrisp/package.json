{
	"name": "@epicenter/honeycrisp",
	"description": "Local-first notes app with collaborative rich-text editing",
	"private": true,
	"version": "0.0.2",
	"type": "module",
	"imports": {
		"#platform/auth": {
			"epicenter-host": "./src/lib/platform/auth.epicenter-host.ts",
			"default": "./src/lib/platform/auth.browser.ts"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"build": "NODE_ENV=production vite build",
		"build:epicenter": "EPICENTER_HOST=1 bun run build",
		"preview": "vite preview",
		"deploy": "wrangler deploy",
		"prepare": "svelte-kit sync || echo ''",
		"test": "bun test --isolate",
		"smoke:editor": "bun evidence/editor/browser.ts",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig ./tsconfig.epicenter-host.json && bun run typecheck:scripts",
		"typecheck:scripts": "tsc -p tsconfig.scripts.json && tsc -p ../self-host/tsconfig.honeycrisp.json"
	},
	"devDependencies": {
		"@epicenter/ui": "workspace:*",
		"@epicenter/vite-config": "workspace:*",
		"@lucide/svelte": "catalog:",
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@types/bun": "catalog:",
		"@types/markdown-it": "^14.0.0",
		"fake-indexeddb": "^6.2.5",
		"mode-watcher": "catalog:",
		"playwright": "^1.61.1",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"svelte-sonner": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"dependencies": {
		"@epicenter/app": "workspace:*",
		"@epicenter/app-shell": "workspace:*",
		"@epicenter/auth": "workspace:*",
		"@epicenter/constants": "workspace:*",
		"@epicenter/device": "workspace:*",
		"@epicenter/svelte": "workspace:*",
		"@epicenter/sync": "workspace:*",
		"@y/prosemirror": "2.0.0-12",
		"@y/y": "14.0.0-rc.26",
		"arktype": "catalog:",
		"better-auth": "catalog:",
		"bits-ui": "catalog:",
		"date-fns": "catalog:",
		"markdown-it": "^14.0.0",
		"prosemirror-commands": "^1.6.0",
		"prosemirror-inputrules": "^1.4.0",
		"prosemirror-keymap": "^1.2.0",
		"prosemirror-markdown": "^1.13.0",
		"prosemirror-model": "^1.25.0",
		"prosemirror-schema-basic": "^1.2.0",
		"prosemirror-schema-list": "^1.4.0",
		"prosemirror-state": "^1.4.0",
		"prosemirror-view": "^1.41.0",
		"wellcrafted": "catalog:"
	},
	"license": "AGPL-3.0-or-later"
}
