{
	"name": "@epicenter/honeycrisp",
	"description": "Local-first notes app with collaborative rich-text editing",
	"private": true,
	"version": "0.0.2",
	"type": "module",
	"exports": {
		".": "./src/lib/workspace/index.ts",
		"./legacy": "./src/lib/workspace/legacy.ts"
	},
	"imports": {
		"#platform/auth": {
			"tauri": "./src/lib/platform/auth.tauri.ts",
			"default": "./src/lib/platform/auth.browser.ts"
		}
	},
	"scripts": {
		"dev": "bun run dev:desktop",
		"dev:web": "vite dev",
		"dev:desktop": "tauri dev",
		"build": "NODE_ENV=production vite build",
		"check:workspace-version-lock": "bun run ../../scripts/check-workspace-version-locks.ts --check --lock workspace-version-lock.json --candidate src/lib/workspace/workspace.ts",
		"preview": "vite preview",
		"deploy": "wrangler deploy",
		"prepare": "svelte-kit sync || echo ''",
		"smoke": "bun run build && bun run smoke.ts",
		"test": "bun test",
		"tauri": "tauri",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"workspace-version-lock": "bun run ../../scripts/check-workspace-version-locks.ts --write --lock workspace-version-lock.json --candidate src/lib/workspace/workspace.ts"
	},
	"devDependencies": {
		"@epicenter/ui": "workspace:*",
		"@epicenter/vite-config": "workspace:*",
		"@lucide/svelte": "catalog:",
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@tauri-apps/cli": "catalog:",
		"@types/bun": "catalog:",
		"mode-watcher": "catalog:",
		"playwright": "^1.61.1",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"svelte-sonner": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"dependencies": {
		"@epicenter/app-shell": "workspace:*",
		"@epicenter/auth": "workspace:*",
		"@epicenter/field": "workspace:*",
		"@epicenter/svelte": "workspace:*",
		"@epicenter/workspace": "workspace:*",
		"@epicenter/constants": "workspace:*",
		"@tauri-apps/api": "catalog:",
		"@tauri-apps/plugin-deep-link": "catalog:",
		"@tauri-apps/plugin-opener": "catalog:",
		"prosemirror-commands": "^1.6.0",
		"prosemirror-inputrules": "^1.4.0",
		"prosemirror-keymap": "^1.2.0",
		"prosemirror-schema-basic": "^1.2.0",
		"prosemirror-schema-list": "^1.4.0",
		"arktype": "catalog:",
		"better-auth": "catalog:",
		"bits-ui": "catalog:",
		"date-fns": "catalog:",
		"nanoid": "catalog:",
		"prosemirror-model": "^1.25.0",
		"typebox": "catalog:",
		"prosemirror-state": "^1.4.0",
		"prosemirror-view": "^1.41.0",
		"wellcrafted": "catalog:",
		"y-indexeddb": "catalog:",
		"y-prosemirror": "^1.3.7",
		"yjs": "catalog:"
	},
	"license": "AGPL-3.0-or-later"
}
