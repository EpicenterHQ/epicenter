{
	"name": "@epicenter/honeycrisp",
	"description": "Honeycrisp: Markdown notes in a repository, as a lens (its definition) and a Svelte root the web shell mounts",
	"private": true,
	"version": "0.0.2",
	"type": "module",
	"exports": {
		".": "./src/data.ts",
		"./app": "./src/components/HoneycrispApp.svelte"
	},
	"scripts": {
		"test": "bun test --isolate --conditions=browser --path-ignore-patterns='**/*.dom.test.ts' ./src && bun run test:dom",
		"test:dom": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun test --isolate --conditions=browser --conditions=svelte dom.test",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@types/jsdom": "21.1.7",
		"jsdom": "26.1.0",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:"
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/language": "^6.13.1",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@epicenter/folder": "workspace:*",
		"@epicenter/repository": "workspace:*",
		"@epicenter/svelte": "workspace:*",
		"@epicenter/ui": "workspace:*",
		"@lucide/svelte": "catalog:",
		"date-fns": "catalog:",
		"typebox": "catalog:",
		"wellcrafted": "catalog:"
	},
	"peerDependencies": {
		"svelte": "catalog:"
	},
	"license": "AGPL-3.0-or-later"
}
