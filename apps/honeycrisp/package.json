{
	"name": "@epicenter/honeycrisp",
	"description": "File-authoritative Markdown notes with a rich-text editor, installed in Epicenter or in a browser tab",
	"private": true,
	"version": "0.0.2",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:ui": "vite dev",
		"build": "NODE_ENV=production vite build",
		"build:installed": "EPICENTER_HOST=1 bun run build",
		"preview": "vite preview",
		"deploy": "wrangler deploy",
		"prepare": "svelte-kit sync || echo ''",
		"test": "bun test --isolate --conditions=browser --path-ignore-patterns='**/*.dom.test.ts' ./src && bun run test:dom",
		"test:dom": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun test --isolate --conditions=browser --conditions=svelte dom.test",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"devDependencies": {
		"@epicenter/ui": "workspace:*",
		"@epicenter/vite-config": "workspace:*",
		"@lucide/svelte": "catalog:",
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@tanstack/query-core": "catalog:",
		"@types/bun": "catalog:",
		"@types/jsdom": "21.1.7",
		"@types/markdown-it": "^14.0.0",
		"fake-indexeddb": "^6.2.6",
		"jsdom": "26.1.0",
		"mode-watcher": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"svelte-sonner": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"dependencies": {
		"@epicenter/constants": "workspace:*",
		"@epicenter/definition": "workspace:*",
		"@epicenter/folder": "workspace:*",
		"@epicenter/svelte": "workspace:*",
		"@tanstack/svelte-query": "catalog:",
		"@tauri-apps/api": "catalog:",
		"bits-ui": "catalog:",
		"date-fns": "catalog:",
		"markdown-it": "^14.0.0",
		"prosemirror-commands": "^1.6.0",
		"prosemirror-history": "^1.5.0",
		"prosemirror-inputrules": "^1.4.0",
		"prosemirror-keymap": "^1.2.0",
		"prosemirror-markdown": "^1.13.0",
		"prosemirror-model": "^1.25.0",
		"prosemirror-schema-basic": "^1.2.0",
		"prosemirror-schema-list": "^1.4.0",
		"prosemirror-state": "^1.4.0",
		"prosemirror-view": "^1.41.0",
		"runed": "catalog:",
		"typebox": "catalog:",
		"wellcrafted": "catalog:"
	},
	"license": "AGPL-3.0-or-later"
}
