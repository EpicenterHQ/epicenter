{
	"name": "@epicenter/tab-manager",
	"description": "Browser extension for live tabs and synchronized web captures",
	"version": "0.0.2",
	"type": "module",
	"private": true,
	"exports": {
		".": "./tab-manager.ts",
		"./browser": "./tab-manager.browser.ts"
	},
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox",
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox",
		"check:workspace-version-lock": "bun run ../../scripts/check-workspace-version-locks.ts --check --lock workspace-version-lock.json --candidate src/versions/v1/workspace.ts",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox",
		"typecheck": "wxt prepare && svelte-check --tsconfig ./tsconfig.json",
		"test": "bun test",
		"workspace-version-lock": "bun run ../../scripts/check-workspace-version-locks.ts --write --lock workspace-version-lock.json --candidate src/versions/v1/workspace.ts",
		"postinstall": "wxt prepare"
	},
	"dependencies": {
		"@epicenter/app-shell": "workspace:*",
		"@epicenter/auth": "workspace:*",
		"@epicenter/constants": "workspace:*",
		"@epicenter/field": "workspace:*",
		"@epicenter/svelte": "workspace:*",
		"@epicenter/ui": "workspace:*",
		"@epicenter/workspace": "workspace:*",
		"@lucide/svelte": "catalog:",
		"@wxt-dev/storage": "^1.2.6",
		"mode-watcher": "^1.1.0",
		"typebox": "catalog:",
		"virtua": "catalog:",
		"wellcrafted": "catalog:"
	},
	"devDependencies": {
		"@tailwindcss/vite": "catalog:",
		"@types/node": "catalog:",
		"@wxt-dev/module-svelte": "^2.0.3",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"wxt": "^0.20.26"
	},
	"license": "AGPL-3.0-or-later"
}
