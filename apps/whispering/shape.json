					"x-field": {
						"kind": "instant"
					}
				},
				"model": {
					"type": "string",
					"x-field": {
						"kind": "string"
					}
				},
				"endpoint": {
					"type": "string",
					"x-field": {
						"kind": "string"
					}
				},
				"prompt": {
					"type": "string",
					"x-field": {
						"kind": "string"
					}
				},
				"input": {
					"type": "string",
					"x-field": {
						"kind": "string"
					}
				}
			},
			"required": [
				"transformationId",
				"transformationTitle",
				"createdAt",
				"model",
				"endpoint",
				"prompt",
				"input"
			]
		}
	}
}
