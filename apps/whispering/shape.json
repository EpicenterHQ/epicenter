				"model": {
					"type": "string",
					"x-field": {
						"kind": "string"
					}
				},
				"endpoint": {
					"type": "string",
					"x-field": {
						"kind": "string"
					}
				},
				"prompt": {
					"type": "string",
					"x-field": {
						"kind": "string"
					}
				},
				"input": {
					"type": "string",
					"x-field": {
						"kind": "string"
					}
				}
			},
			"required": [
				"recordingId",
				"transcriptionId",
				"transformationId",
				"transformationTitle",
				"createdAt",
				"model",
				"endpoint",
				"prompt",
				"input"
			]
		},
		"text_runs": {
			"type": "object",
			"properties": {
