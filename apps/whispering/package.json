{
	"name": "@epicenter/whispering",
	"private": true,
	"version": "7.11.1",
	"description": "Voice notes in a browser tab: recordings, transcripts, and transformations are files kept in this browser for good; signing in only adds hosted transcription and AI",
	"type": "module",
	"imports": {
		"#platform/auth": "./src/lib/platform/auth.ts",
		"#platform/services": "./src/lib/platform/browser.ts"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:ui": "vite dev",
		"test": "bun test --isolate --conditions=browser --conditions=svelte --path-ignore-patterns='**/*.postgres.test.ts' src",
		"test:postgres": "bun test --isolate ./src/lib/platform/web-sign-in.postgres.test.ts",
		"test:e2e": "playwright test -c playwright.config.ts",
		"build": "NODE_ENV=production vite build",
		"check": "bun run typecheck",
		"contract": "bun scripts/write-contract.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"license": "AGPL-3.0-or-later",
	"devDependencies": {
		"@epicenter/ui": "workspace:*",
		"@epicenter/vite-config": "workspace:*",
		"@lucide/svelte": "catalog:",
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@types/bun": "catalog:",
		"mode-watcher": "catalog:",
		"playwright": "^1.61.1",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"svelte-sonner": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plugin-devtools-json": "^1.0.0"
	},
	"dependencies": {
		"@epicenter/ai": "workspace:*",
		"@epicenter/auth": "workspace:*",
		"@epicenter/constants": "workspace:*",
		"@epicenter/definition": "workspace:*",
		"@epicenter/folder": "workspace:*",
		"@epicenter/recorder": "workspace:*",
		"@epicenter/svelte": "workspace:*",
		"runed": "catalog:",
		"wellcrafted": "catalog:"
	}
}
