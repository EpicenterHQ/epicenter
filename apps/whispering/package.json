{
	"name": "@epicenter/whispering",
	"private": true,
	"version": "7.11.1",
	"description": "Standalone desktop recorder: recordings, transcripts, and settings are files in a Git-versioned folder",
	"type": "module",
	"scripts": {
		"dev": "tauri dev",
		"dev:ui": "vite dev",
		"test": "bun ../../packages/folder/scripts/build-addon.ts && bun test --isolate --path-ignore-patterns='src/routes/**' && bun run test:mounted",
		"test:mounted": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun test --isolate --conditions=browser --conditions=svelte src/routes",
		"test:quit": "cargo run --locked --manifest-path src-tauri/Cargo.toml --example quit --",
		"build": "NODE_ENV=production vite build",
		"build:epicenter": "EPICENTER_HOST=1 bun run build",
		"build:sidecar": "bun scripts/build-sidecar.ts",
		"build:desktop": "tauri build",
		"tauri": "tauri",
		"check": "bun run typecheck",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.native.json"
	},
	"license": "AGPL-3.0-or-later",
	"devDependencies": {
		"@epicenter/ui": "workspace:*",
		"@epicenter/vite-config": "workspace:*",
		"@lucide/svelte": "catalog:",
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@tauri-apps/api": "catalog:",
		"@tauri-apps/cli": "catalog:",
		"@types/bun": "catalog:",
		"@types/jsdom": "21.1.7",
		"jsdom": "26.1.0",
		"mode-watcher": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"svelte-sonner": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plugin-devtools-json": "^1.0.0"
	},
	"dependencies": {
		"@epicenter/constants": "workspace:*",
		"@epicenter/definition": "workspace:*",
		"@epicenter/folder": "workspace:*",
		"@epicenter/svelte": "workspace:*",
		"@tanstack/svelte-query": "catalog:",
		"nanoid": "catalog:",
		"wellcrafted": "catalog:"
	}
}
