{
	"name": "@epicenter/whispering",
	"private": true,
	"version": "7.11.1",
	"description": "Speech-to-text SPA served by the Epicenter desktop host",
	"imports": {
		"#platform/analytics": {
			"epicenter-host": "./src/lib/services/analytics/index.tauri.ts",
			"default": "./src/lib/services/analytics/index.browser.ts"
		},
		"#platform/auth": {
			"epicenter-host": "./src/lib/platform/auth.epicenter-host.ts",
			"default": "./src/lib/platform/auth.browser.ts"
		},
		"#platform/commands": {
			"epicenter-host": "./src/lib/commands.tauri.ts",
			"default": "./src/lib/commands.browser.ts"
		},
		"#platform/dictation-indicator": {
			"epicenter-host": "./src/lib/dictation-indicator/DictationIndicator.tauri.svelte",
			"default": "./src/lib/dictation-indicator/DictationIndicator.browser.svelte"
		},
		"#platform/download": {
			"epicenter-host": "./src/lib/services/download/index.tauri.ts",
			"default": "./src/lib/services/download/index.browser.ts"
		},
		"#platform/manual-recorder-config": {
			"epicenter-host": "./src/lib/state/manual-recorder-config.tauri.ts",
			"default": "./src/lib/state/manual-recorder-config.browser.ts"
		},
		"#platform/os": {
			"epicenter-host": "./src/lib/platform/os.tauri.ts",
			"default": "./src/lib/platform/os.browser.ts"
		},
		"#platform/os-notify": {
			"epicenter-host": "./src/lib/report/os-notify.tauri.ts",
			"default": "./src/lib/report/os-notify.browser.ts"
		},
		"#platform/recording-mic-level": {
			"epicenter-host": "./src/lib/recording-overlay/mic-level.tauri.ts",
			"default": "./src/lib/recording-overlay/mic-level.browser.svelte.ts"
		},
		"#platform/system-shortcuts": {
			"epicenter-host": "./src/lib/platform/system-shortcuts.tauri.ts",
			"default": "./src/lib/platform/system-shortcuts.browser.ts"
		},
		"#platform/tauri": {
			"epicenter-host": "./src/lib/tauri.tauri.ts",
			"default": "./src/lib/tauri.browser.ts"
		},
		"#platform/text": {
			"epicenter-host": "./src/lib/services/text/index.tauri.ts",
			"default": "./src/lib/services/text/index.browser.ts"
		},
		"#platform/window-events": {
			"epicenter-host": "./src/lib/window-events.tauri.ts",
			"default": "./src/lib/window-events.browser.ts"
		},
		"#platform/runtime": {
			"epicenter-host": "./src/lib/platform/runtime.epicenter-host.ts",
			"default": "./src/lib/platform/runtime.browser.ts"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"test": "bun test --isolate",
		"build": "NODE_ENV=production vite build",
		"build:epicenter": "EPICENTER_HOST=1 bun run build",
		"check": "bun run typecheck",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig ./tsconfig.epicenter-host.json",
		"typecheck:epicenter-host": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.epicenter-host.json",
		"typecheck:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"license": "AGPL-3.0-or-later",
	"devDependencies": {
		"@epicenter/sqlite": "workspace:*",
		"@epicenter/sync": "workspace:*",
		"@epicenter/ui": "workspace:*",
		"@epicenter/vite-config": "workspace:*",
		"@types/bun": "catalog:",
		"@lucide/svelte": "catalog:",
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/typography": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@types/js-yaml": "^4.0.9",
		"fake-indexeddb": "^6.2.5",
		"mode-watcher": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"svelte-sonner": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plugin-devtools-json": "^1.0.0",
		"vite-plugin-static-copy": "^4.1.1"
	},
	"type": "module",
	"dependencies": {
		"@aptabase/web": "^0.4.3",
		"@epicenter/app": "workspace:*",
		"@epicenter/app-shell": "workspace:*",
		"@epicenter/auth": "workspace:*",
		"@epicenter/blobs": "workspace:*",
		"@epicenter/principal": "workspace:*",
		"@epicenter/client": "workspace:*",
		"@epicenter/constants": "workspace:*",
		"@epicenter/data": "workspace:*",
		"@epicenter/device": "workspace:*",
		"@epicenter/recorder": "workspace:*",
		"@epicenter/svelte": "workspace:*",
		"@standard-schema/spec": "catalog:",
		"@tanstack/svelte-query": "catalog:",
		"@tanstack/svelte-table": "catalog:",
		"@tanstack/table-core": "9.0.0-alpha.10",
		"@tauri-apps/api": "catalog:",
		"@tauri-apps/plugin-deep-link": "catalog:",
		"@tauri-apps/plugin-dialog": "^2.3.2",
		"@tauri-apps/plugin-fs": "catalog:",
		"@tauri-apps/plugin-notification": "^2.3.0",
		"@tauri-apps/plugin-opener": "catalog:",
		"@tauri-apps/plugin-os": "^2.3.0",
		"arkregex": "catalog:",
		"arktype": "catalog:",
		"audio-recorder-polyfill": "^0.4.1",
		"bits-ui": "catalog:",
		"date-fns": "catalog:",
		"dexie": "^4.0.11",
		"dompurify": "^3.4.10",
		"fflate": "catalog:",
		"idb": "^8.0.3",
		"js-yaml": "^4.1.1",
		"marked": "catalog:",
		"nanoid": "catalog:",
		"tailwind-variants": "catalog:",
		"typebox": "catalog:",
		"wellcrafted": "catalog:",
		"openai": "^7.12.1"
	}
}
