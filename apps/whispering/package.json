{
	"name": "@epicenter/whispering",
	"private": true,
	"version": "7.11.1",
	"description": "Voice notes: recordings, transcripts, and transformations are files, kept in your Epicenter repository on the web or, in the desktop app, in a folder on this computer",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:ui": "vite dev",
		"test": "bun test --isolate --conditions=browser --conditions=svelte --conditions=test --path-ignore-patterns='**/*.postgres.test.ts' src",
		"test:postgres": "bun test --isolate ./src/lib/web-sign-in.postgres.test.ts",
		"build": "NODE_ENV=production vite build",
		"dev:desktop": "tauri dev --config src-tauri/tauri.dev.conf.json",
		"build:desktop": "tauri build --bundles app",
		"check": "bun run typecheck",
		"contract": "bun scripts/write-contract.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"license": "AGPL-3.0-or-later",
	"devDependencies": {
		"@epicenter/ui": "workspace:*",
		"@epicenter/vite-config": "workspace:*",
		"@lucide/svelte": "catalog:",
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@tauri-apps/cli": "catalog:",
		"@types/bun": "catalog:",
		"mode-watcher": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"svelte-sonner": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plugin-devtools-json": "^1.0.0"
	},
	"dependencies": {
		"@epicenter/account": "workspace:*",
		"@epicenter/ai": "workspace:*",
		"@epicenter/definition": "workspace:*",
		"@epicenter/folder": "workspace:*",
		"@epicenter/local": "workspace:*",
		"@epicenter/recorder": "workspace:*",
		"@epicenter/svelte": "workspace:*",
		"@epicenter/transcription": "workspace:*",
		"@tauri-apps/api": "catalog:",
		"runed": "catalog:",
		"wellcrafted": "catalog:"
	}
}
