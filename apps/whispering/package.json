{
	"name": "@epicenter/whispering",
	"private": true,
	"version": "7.11.1",
	"description": "Voice notes: recordings, transcripts, and settings are files in a Git-versioned folder, in Epicenter or a browser tab",
	"type": "module",
	"imports": {
		"#platform/services": {
			"epicenter-host": "./src/lib/platform/desktop/services.ts",
			"default": "./src/lib/platform/browser.ts"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"dev:ui": "vite dev",
		"test": "bun test --isolate --path-ignore-patterns='src/routes/**' && bun run test:mounted",
		"test:mounted": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun test --isolate --conditions=browser --conditions=svelte src/routes",
		"build": "NODE_ENV=production vite build",
		"build:host": "EPICENTER_HOST=1 bun run build",
		"check": "bun run typecheck",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig ./tsconfig.epicenter-host.json"
	},
	"license": "AGPL-3.0-or-later",
	"devDependencies": {
		"@epicenter/ui": "workspace:*",
		"@epicenter/vite-config": "workspace:*",
		"@lucide/svelte": "catalog:",
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@tanstack/query-core": "catalog:",
		"@tauri-apps/api": "catalog:",
		"@tauri-apps/plugin-opener": "catalog:",
		"@types/bun": "catalog:",
		"@types/jsdom": "21.1.7",
		"fake-indexeddb": "^6.2.6",
		"jsdom": "26.1.0",
		"mode-watcher": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"svelte-sonner": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plugin-devtools-json": "^1.0.0"
	},
	"dependencies": {
		"@epicenter/ai": "workspace:*",
		"@epicenter/constants": "workspace:*",
		"@epicenter/definition": "workspace:*",
		"@epicenter/folder": "workspace:*",
		"@epicenter/recorder": "workspace:*",
		"@epicenter/svelte": "workspace:*",
		"@tanstack/svelte-query": "catalog:",
		"typebox": "catalog:",
		"nanoid": "catalog:",
		"runed": "catalog:",
		"wellcrafted": "catalog:"
	}
}
