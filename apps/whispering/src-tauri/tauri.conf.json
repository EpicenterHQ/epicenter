{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Whispering",
	"version": "7.11.1",
	"identifier": "so.epicenter.whispering",
	"build": {
		"beforeDevCommand": {
			"script": "bun run build && bun run build:sidecar",
			"wait": true
		},
		"beforeBuildCommand": "bun run build && bun run build:sidecar",
		"frontendDist": "shell"
	},
	"app": {
		"windows": [],
		"security": {
			"capabilities": [],
			"csp": "default-src 'none'; style-src 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
		}
	},
	"bundle": {
		"active": true,
		"targets": ["app"],
		"category": "Productivity",
		"publisher": "Epicenter",
		"copyright": "Copyright © 2026 Epicenter",
		"shortDescription": "Record, transcribe, and keep it all as files",
		"externalBin": ["binaries/whispering-host"],
		"resources": {
			"../build": "ui"
		},
		"icon": ["icons/icon.png", "icons/icon.icns"],
		"macOS": {
			"entitlements": "entitlements.plist",
			"hardenedRuntime": true,
			"minimumSystemVersion": "10.15",
			"signingIdentity": "-"
		}
	}
}
