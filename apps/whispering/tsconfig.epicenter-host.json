{
	// Typechecks the build Epicenter serves, which activates the one condition
	// Whispering's seams split on: `epicenter-host` selects the leaves whose
	// owner is the Bun host (credential, keychain and files, recording bytes).
	// `tsconfig.json` resolves the `default` (browser) leaves, so the host
	// leaves and the call sites that wire them are only checked here. `bun run
	// typecheck` runs both configs (ADR-0347).
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"customConditions": ["epicenter-host"]
	}
}
