{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Git lab",
	"version": "0.0.1",
	"identifier": "so.epicenter.git-lab",
	"build": {
		"beforeDevCommand": {
			"script": "bun run build:desktop-ui",
			"wait": true
		},
		"beforeBuildCommand": "bun run build:desktop-ui",
		"frontendDist": "../build-desktop"
	},
	"app": {
		"windows": [
			{
				"label": "copy-a",
				"title": "Git lab \u00b7 A",
				"width": 1280,
				"height": 820
			},
			{
				"label": "copy-b",
				"title": "Git lab \u00b7 B",
				"width": 1280,
				"height": 820
			}
		],
		"security": {
			"capabilities": ["main"],
			"csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
		}
	},
	"plugins": {
		"fs": {
			"requireLiteralLeadingDot": false
		}
	},
	"bundle": {
		"active": true,
		"targets": ["app"],
		"category": "Productivity",
		"publisher": "Epicenter",
		"copyright": "Copyright \u00a9 2026 Epicenter",
		"shortDescription": "A file editor and Git synchronization testbed",
		"icon": ["icons/icon.png", "icons/icon.icns"]
	}
}
