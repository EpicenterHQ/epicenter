{
	"name": "vocab",
	"description": "Vocab: a Markdown note per saved expression (the learner’s note in its body), per tutor chat, and per finished chat message.",
	"collections": {
		"entries": {
			"path": "entries/{id}.md",
			"fields": {
				"text": {
					"type": "string"
				},
				"stage": {
					"enum": ["new", "recognized", "understood", "usable"]
				},
				"createdAt": {
					"type": "string"
				}
			},
			"required": ["text", "stage", "createdAt"]
		},
		"chats": {
			"path": "chats/{id}.md",
			"fields": {
				"createdAt": {
					"type": "string"
				},
				"focus": {
					"type": "array",
					"minItems": 1,
					"maxItems": 3,
					"items": {
						"type": "object",
						"properties": {
							"entryId": {
								"type": "string"
							},
							"text": {
								"type": "string"
							}
						},
						"required": ["entryId", "text"]
					}
				}
			},
			"required": ["createdAt", "focus"]
		},
		"messages": {
			"path": "messages/{chat}/{id}.md",
			"fields": {
				"role": {
					"enum": ["user", "assistant"]
				},
				"createdAt": {
					"type": "number"
				},
				"parts": {
					"type": "array",
					"items": {
						"anyOf": [
							{
								"type": "object",
								"properties": {
									"type": {
										"const": "text"
									},
									"text": {
										"type": "string"
									}
								},
								"required": ["type", "text"]
							},
							{
								"type": "object",
								"properties": {
									"type": {
										"const": "tool-call"
									},
									"toolCallId": {
										"type": "string"
									},
									"toolName": {
										"type": "string"
									},
									"input": {}
								},
								"required": ["type", "toolCallId", "toolName", "input"]
							},
							{
								"type": "object",
								"properties": {
									"type": {
										"const": "tool-result"
									},
									"toolCallId": {
										"type": "string"
									},
									"toolName": {
										"type": "string"
									},
									"content": {
										"type": "string"
									},
									"details": {},
									"isError": {
										"type": "boolean"
									}
								},
								"required": [
									"type",
									"toolCallId",
									"toolName",
									"content",
									"isError"
								]
							}
						]
					}
				}
			},
			"required": ["role", "createdAt", "parts"]
		}
	}
}
