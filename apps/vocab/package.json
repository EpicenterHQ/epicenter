{
	"name": "@epicenter/vocab",
	"description": "English vocabulary tutor whose words and chats are Markdown notes, kept in the browser and uploaded to the learner's repository when signed in",
	"private": true,
	"version": "0.0.2",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "NODE_ENV=production vite build",
		"build:native": "EPICENTER_DESKTOP=1 NODE_ENV=production vite build",
		"dev:desktop": "bun run build:native && tauri dev --config src-tauri/tauri.dev.conf.json",
		"build:desktop": "bun run build:native && tauri build --bundles app",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"test": "bun test --conditions=browser --conditions=svelte src/lib && bun run test:svelte",
		"test:svelte": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun test --conditions=browser --conditions=svelte src/routes",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && EPICENTER_DESKTOP=1 svelte-kit sync && svelte-check --tsconfig ./tsconfig.tauri.json; status=$?; svelte-kit sync; exit $status",
		"contract": "bun scripts/write-contract.ts",
		"demo": "bun e2e/stack.ts --demo",
		"test:e2e": "playwright test -c playwright.config.ts",
		"deploy": "wrangler deploy"
	},
	"dependencies": {
		"@epicenter/agent": "workspace:*",
		"@epicenter/auth": "workspace:*",
		"@epicenter/client": "workspace:*",
		"@epicenter/constants": "workspace:*",
		"@epicenter/folder": "workspace:*",
		"@epicenter/recorder": "workspace:*",
		"@epicenter/svelte": "workspace:*",
		"@epicenter/ui": "workspace:*",
		"@lucide/svelte": "catalog:",
		"mode-watcher": "^1.1.0",
		"openai": "^7.12.1",
		"runed": "catalog:",
		"wellcrafted": "catalog:",
		"@epicenter/ai": "workspace:*",
		"@epicenter/definition": "workspace:*",
		"@tauri-apps/api": "catalog:"
	},
	"devDependencies": {
		"@epicenter/vite-config": "workspace:*",
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@tauri-apps/cli": "catalog:",
		"@types/bun": "catalog:",
		"@types/jsdom": "21.1.7",
		"jsdom": "26.1.0",
		"playwright": "^1.61.1",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plugin-static-copy": "^4.1.1"
	},
	"license": "AGPL-3.0-or-later",
	"imports": {
		"#platform/auth": {
			"tauri": "./src/lib/platform/auth.tauri.ts",
			"default": "./src/lib/platform/auth.browser.ts"
		},
		"#platform/connections": {
			"tauri": "./src/lib/platform/connections.tauri.ts",
			"default": "./src/lib/platform/connections.browser.ts"
		}
	}
}
