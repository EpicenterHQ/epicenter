{
	"name": "@epicenter/vocab",
	"description": "English vocabulary tutor whose words and chats are Markdown notes: online in the signed-in learner's Epicenter repository, or on the desktop in a folder Vocab keeps them in",
	"private": true,
	"version": "0.0.2",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "NODE_ENV=production vite build",
		"dev:desktop": "tauri dev --config src-tauri/tauri.dev.conf.json",
		"build:desktop": "tauri build --bundles app",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"test": "bun run test:lib; failed=$?; bun run test:svelte && exit $failed",
		"test:lib": "bun test --conditions=browser --conditions=svelte --conditions=test src/lib",
		"test:svelte": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun test --conditions=browser --conditions=svelte --conditions=test src/routes",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"contract": "bun scripts/write-contract.ts",
		"deploy": "wrangler deploy"
	},
	"dependencies": {
		"@epicenter/account": "workspace:*",
		"@epicenter/ai": "workspace:*",
		"@epicenter/definition": "workspace:*",
		"@epicenter/folder": "workspace:*",
		"@epicenter/local": "workspace:*",
		"@epicenter/recorder": "workspace:*",
		"@epicenter/svelte": "workspace:*",
		"@epicenter/ui": "workspace:*",
		"@lucide/svelte": "catalog:",
		"@tauri-apps/api": "catalog:",
		"mode-watcher": "^1.1.0",
		"runed": "catalog:",
		"wellcrafted": "catalog:"
	},
	"devDependencies": {
		"@epicenter/vite-config": "workspace:*",
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@tauri-apps/cli": "catalog:",
		"@types/bun": "catalog:",
		"@types/jsdom": "21.1.7",
		"jsdom": "26.1.0",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plugin-static-copy": "^4.1.1"
	},
	"license": "AGPL-3.0-or-later"
}
