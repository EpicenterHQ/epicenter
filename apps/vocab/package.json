{
	"name": "@epicenter/vocab",
	"description": "English vocabulary tutor whose words and chats are files in one local folder",
	"private": true,
	"version": "0.0.2",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "NODE_ENV=production vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"test": "bun test src/lib && bun run test:svelte",
		"test:svelte": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun test --conditions=browser --conditions=svelte src/routes",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"deploy": "wrangler deploy"
	},
	"dependencies": {
		"@epicenter/agent": "workspace:*",
		"@epicenter/auth": "workspace:*",
		"@epicenter/client": "workspace:*",
		"@epicenter/constants": "workspace:*",
		"@epicenter/folder": "workspace:*",
		"@epicenter/recorder": "workspace:*",
		"@epicenter/svelte": "workspace:*",
		"@epicenter/ui": "workspace:*",
		"@lucide/svelte": "catalog:",
		"@tanstack/svelte-query": "catalog:",
		"buffer": "^6.0.3",
		"mode-watcher": "^1.1.0",
		"openai": "^7.12.1",
		"typebox": "catalog:",
		"wellcrafted": "catalog:",
		"@epicenter/ai": "workspace:*",
		"@epicenter/definition": "workspace:*"
	},
	"devDependencies": {
		"@epicenter/vite-config": "workspace:*",
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@tanstack/query-core": "catalog:",
		"@types/bun": "catalog:",
		"@types/jsdom": "21.1.7",
		"jsdom": "26.1.0",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plugin-static-copy": "^4.1.1"
	},
	"license": "AGPL-3.0-or-later"
}
