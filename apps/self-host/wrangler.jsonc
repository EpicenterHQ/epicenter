{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "self-host",
	"main": "worker/index.ts",
	"compatibility_date": "2026-03-06",
	"compatibility_flags": ["nodejs_compat", "enable_request_signal"],
	"send_metrics": false,
	"vars": {
		// Replace with this deployment's canonical HTTPS origin.
		"API_PUBLIC_ORIGIN": "https://instance.example.com",
		// Exact browser app origins allowed through CORS.
		"TRUSTED_BROWSER_ORIGINS": "",
		// JSON array of exact application callback URLs. Empty refuses handoff.
		"SELF_HOST_CALLBACKS": "[]"
	},
	// Optional provider house keys and BLOBS_S3_* configuration stay deployment-owned.
	// Named users enroll through the auth owner. INSTANCE_TOKEN no longer authorizes requests.
	"durable_objects": {
		"bindings": [
			{ "name": "STORE_AUTHORITY", "class_name": "StoreAuthority" },
			{ "name": "GENERATIONS_LEDGER", "class_name": "GenerationsLedger" },
			{ "name": "SELF_HOST_AUTH", "class_name": "SelfHostAuthOwner" }
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["StoreAuthority", "GenerationsLedger"]
		},
		{
			"tag": "v2-auth",
			"new_sqlite_classes": ["SelfHostAuthOwner"]
		}
	]
}
