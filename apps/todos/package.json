{
	"name": "@epicenter/todos",
	"description": "Todos as Markdown notes: online in the signed-in person's Epicenter repository, or on the desktop in a folder Todos keeps its todos in",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:ui": "vite dev",
		"build": "NODE_ENV=production vite build",
		"dev:desktop": "tauri dev --config src-tauri/tauri.dev.conf.json",
		"build:desktop": "tauri build --bundles app",
		"preview": "vite preview",
		"demo": "bun e2e/stack.ts --demo",
		"contract": "bun scripts/write-contract.ts",
		"native": "bun scripts/native.ts",
		"prepare": "svelte-kit sync || echo ''",
		"test": "bun test --isolate --conditions=browser --conditions=svelte --conditions=test src scripts",
		"test:e2e": "playwright test -c playwright.config.ts",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.scripts.json"
	},
	"devDependencies": {
		"@epicenter/ui": "workspace:*",
		"@epicenter/vite-config": "workspace:*",
		"@lucide/svelte": "catalog:",
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@tauri-apps/cli": "catalog:",
		"@types/bun": "catalog:",
		"drizzle-orm": "catalog:",
		"mode-watcher": "catalog:",
		"playwright": "^1.61.1",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"svelte-sonner": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"dependencies": {
		"@epicenter/account": "workspace:*",
		"@epicenter/definition": "workspace:*",
		"@epicenter/folder": "workspace:*",
		"@epicenter/svelte": "workspace:*",
		"@tauri-apps/api": "catalog:",
		"wellcrafted": "catalog:"
	},
	"license": "AGPL-3.0-or-later"
}
