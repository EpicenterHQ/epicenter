{
	"name": "@epicenter/todos",
	"description": "Todos: Markdown todos in a repository, as a lens (its definition) and a Svelte root the web shell mounts",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"exports": {
		".": "./src/definition.ts",
		"./app": "./src/TodosApp.svelte"
	},
	"scripts": {
		"schema:export": "bun scripts/export-schema.ts",
		"native": "bun scripts/native.ts",
		"test": "bun test --isolate --path-ignore-patterns='src/**/*.mounted.test.ts' && bun run test:mounted",
		"test:mounted": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun test --isolate --conditions=browser --conditions=svelte mounted.test",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.scripts.json"
	},
	"devDependencies": {
		"@sveltejs/kit": "catalog:",
		"@tauri-apps/cli": "catalog:",
		"@types/bun": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:"
	},
	"dependencies": {
		"@epicenter/folder": "workspace:*",
		"@epicenter/repository": "workspace:*",
		"@epicenter/svelte": "workspace:*",
		"@epicenter/ui": "workspace:*",
		"@lucide/svelte": "catalog:",
		"@tauri-apps/api": "catalog:",
		"typebox": "catalog:",
		"wellcrafted": "catalog:"
	},
	"license": "AGPL-3.0-or-later",
	"peerDependencies": {
		"@sveltejs/kit": "catalog:",
		"svelte": "catalog:"
	}
}
