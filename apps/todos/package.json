{
	"name": "@epicenter/todos",
	"description": "Local Markdown todos over one Folder",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"exports": {
		"./definition": "./src/lib/definition.ts"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:ui": "vite dev",
		"dev:desktop": "bun run build:installed && tauri dev --config src-tauri/tauri.dev.conf.json",
		"build:desktop": "bun run build:installed && tauri build --bundles app",
		"native": "bun scripts/native.ts",
		"demo:local": "bun scripts/local-demo.ts",
		"build": "NODE_ENV=production vite build",
		"build:installed": "EPICENTER_HOST=1 bun run build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"test": "bun test --isolate --path-ignore-patterns='src/**/*.mounted.test.ts' && bun run test:mounted",
		"test:mounted": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun test --isolate --conditions=browser --conditions=svelte mounted.test",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.scripts.json"
	},
	"devDependencies": {
		"@epicenter/ui": "workspace:*",
		"@epicenter/vite-config": "workspace:*",
		"@lucide/svelte": "catalog:",
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@tauri-apps/cli": "catalog:",
		"@types/bun": "catalog:",
		"fake-indexeddb": "^6.2.6",
		"mode-watcher": "catalog:",
		"playwright": "^1.61.1",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"svelte-sonner": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"dependencies": {
		"@epicenter/folder": "workspace:*",
		"@epicenter/svelte": "workspace:*",
		"@tanstack/svelte-query": "catalog:",
		"wellcrafted": "catalog:",
		"typebox": "catalog:"
	},
	"license": "AGPL-3.0-or-later"
}
