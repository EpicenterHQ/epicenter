{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "api",
	"main": "worker/index.ts",
	"minify": true,
	"compatibility_date": "2026-03-06",
	// global_fetch_strictly_public keeps every outbound fetch on the public
	// internet: a request this Worker makes never reaches a private or
	// loopback address, whatever URL it was handed.
	"compatibility_flags": [
		"nodejs_compat",
		"enable_request_signal",
		"global_fetch_strictly_public"
	],
	"send_metrics": false,
	// Build the cloud UI SPA before publishing. Wrangler runs build.command for
	// `deploy` and `versions upload`, so local, CI prod, and CI preview build
	// through one definition. Skip it for `dev`/`types`: the local `wrangler dev`
	// launcher (scripts/dev.ts) rebuilds the UI at startup so the server and the
	// authorization server's pages come from one checkout.
	"build": {
		"command": "case \"$WRANGLER_COMMAND\" in dev|types) ;; *) bun run --cwd ui build ;; esac"
	},
	// --- Static assets: cloud UI SPA (built by SvelteKit adapter-static) ---
	// SvelteKit writes hashed assets to ui/build/_app/* plus a fallback.html
	// shell. The asset layer serves matching files (/_app/*, favicon) before the
	// Worker runs; UI URLs (/dashboard, /sign-in, /consent)
	// match no file and fall through to Hono, which serves fallback.html for
	// the routes it owns. The shell is deliberately not index.html so the asset
	// layer never shadows the Worker's `/` route. `html_handling: none` keeps
	// /fallback.html reachable at its literal path; the default
	// auto-trailing-slash mode 307-redirects it to /fallback, which breaks the
	// Worker's `ASSETS.fetch('/fallback.html')` shell handoff (a 503, not a
	// shell). This SPA has no pretty-URL pages, so extension magic buys nothing.
	"assets": {
		"directory": "./ui/build",
		"binding": "ASSETS",
		"html_handling": "none"
	},
	// --- Custom domain: api.epicenter.so (auto-creates DNS record on deploy) ---
	"routes": [
		{
			"pattern": "api.epicenter.so",
			"custom_domain": true
		}
	],
	// --- Vars: non-secret config accessible via env ---
	// The public origin (Better Auth baseURL, OAuth issuer, token audience) is
	// intentionally NOT here. It never changes for the hosted cloud, so the
	// worker bakes `PRODUCTION_API_URL` from @epicenter/constants and local dev
	// overrides it via `API_PUBLIC_ORIGIN` (apps/api/scripts/dev.ts). This keeps
	// a single source of truth in TypeScript instead of a duplicated string.
	//
	// ARTIFACTS_NAMESPACE repeats the Artifacts binding's namespace below: the
	// binding creates repositories and mints their tokens, while the Git data
	// plane forwards to `https://<account>.artifacts.cloudflare.net/git/<namespace>/...`
	// directly. worker/git-repositories.test.ts asserts the two agree.
	//
	// LFS_BUCKET_NAME repeats the R2 binding's bucket below: the binding reads and
	// writes objects, while presigned transfer URLs name the bucket on R2's S3
	// endpoint. worker/git-repositories.test.ts asserts the two agree.
	"vars": {
		"ARTIFACTS_NAMESPACE": "epicenter-production",
		"LFS_BUCKET_NAME": "epicenter-lfs"
	},
	// --- R2: Git LFS objects (decisions 17, 73, 85 and 98) ---
	// Bound here, never in the dashboard: a dashboard binding is overwritten on
	// the next deploy. The receiver's LFS path also needs the R2_ACCESS_KEY_ID
	// and R2_SECRET_ACCESS_KEY pair that presigns transfers; they are optional
	// secrets (not in `secrets.required`), and until both reach the deployed
	// version hosted Git answers 503 (worker/lfs-store.ts). See README.md,
	// "Deploying R2 LFS", for the order.
	"r2_buckets": [
		{
			"binding": "LFS_BUCKET",
			"bucket_name": "epicenter-lfs"
		}
	],
	// --- Artifacts: hosted Git repositories (ADR-0546) ---
	// One namespace per environment, one repository per repository id (the
	// `repository` table's immutable id, never a URL segment). The binding has no local
	// emulation: direct `wrangler dev` opens a remote Artifacts session.
	// Use `bun dev:api`, whose launcher removes this production binding.
	"artifacts": [
		{
			"binding": "ARTIFACTS",
			"namespace": "epicenter-production"
		}
	],
	// --- Durable Objects ---
	// The Worker has none, and carries no migration history. The Worker that
	// held StoreAuthority, GenerationsLedger, and GitHubConnection (migrations
	// v1 to v7) is deleted and recreated rather than migrated: deploying this
	// configuration starts by deleting the existing `api` Worker, which removes
	// every Durable Object it stored (ADR-0534).

	// --- Secrets (synced from Infisical prod /api, typed via `wrangler types`) ---
	"secrets": {
		"required": [
			"BETTER_AUTH_SECRET",
			// GOOGLE_CLIENT_ID is public OAuth metadata, not a secret, but it is
			// deployment-owned config. Keep it with the matching secret so local
			// dev and production cannot accidentally share a checked-in client id.
			"GOOGLE_CLIENT_ID",
			"GOOGLE_CLIENT_SECRET",
			// The shared server library keeps every provider register-when-present,
			// but the hosted cloud product promise is stricter: the hosted sign-in UI
			// offers only providers with production credentials. Listing those
			// provider bindings here makes Wrangler fail deploy/typegen when the
			// hosted edge is missing a provider the UI would show. A required `string`
			// here still satisfies the library's optional CloudAuthBindings fields.
			"GITHUB_CLIENT_ID",
			"GITHUB_CLIENT_SECRET",
			"MICROSOFT_CLIENT_ID",
			"MICROSOFT_CLIENT_SECRET",
			// House AI keys are required here even though the library types them
			// as optional bindings: hosted credits are billed against house-key
			// usage, so a deploy without them would 503 paying users.
			"OPENAI_API_KEY",
			"AUTUMN_SECRET_KEY",
			"GEMINI_API_KEY",
			// The Cloudflare account that owns the Artifacts namespace. The Git
			// data plane forwards to `https://<accountId>.artifacts.cloudflare.net`,
			// grouped as a secret so the account id stays out of committed config.
			"ARTIFACTS_ACCOUNT_ID"
		]
	},
	// --- Hyperdrive: Postgres connection pool ---
	// Create with: bunx wrangler hyperdrive create epicenter-db --connection-string="postgres://..." --caching-disabled
	// This Worker is the OAuth authorization server, and every resource checks
	// tokens in this database. The configuration must have caching disabled:
	// Hyperdrive's default 60-second query cache would serve a revoked token
	// as live (ADR-0549). See apps/api/README.md.
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "aa342cd8cddf472abd74c189505d7867",
			"localConnectionString": "postgres://postgres:postgres@localhost:5432/epicenter"
		}
	],
	// Smart Placement: Run your Worker close to your database for lower latency
	"placement": {
		"region": "aws:eu-central-1"
	},
	// Raise the per-invocation CPU ceiling to 5 min: the /api/ai/chat SSE stream
	// holds open for minutes of wall-clock, though most of that is provider I/O
	// wait (low CPU). Billing is on actual CPU used, so the higher ceiling is
	// headroom, not cost.
	"limits": { "cpu_ms": 300000 }
}
