{
	"name": "@epicenter/capture-app",
	"description": "File-first captures: one Markdown file per capture, with its thoughts",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#platform/folder": {
			"epicenter-host": "./src/lib/platform/folder.epicenter-host.ts",
			"default": "./src/lib/platform/folder.browser.ts"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"build": "NODE_ENV=production vite build",
		"build:installed": "EPICENTER_HOST=1 bun run build",
		"preview": "vite preview",
		"smoke:browser": "bun scripts/browser-smoke.ts",
		"prepare": "svelte-kit sync || echo ''",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig ./tsconfig.epicenter-host.json && tsc -p tsconfig.scripts.json",
		"test": "bun test --isolate --path-ignore-patterns='**/*.mounted.test.ts' && bun run test:mounted",
		"test:mounted": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun test --isolate --conditions=browser --conditions=svelte src/lib/components"
	},
	"dependencies": {
		"@epicenter/capture": "workspace:*",
		"@epicenter/constants": "workspace:*",
		"@epicenter/epicenter": "workspace:*",
		"@epicenter/folder": "workspace:*",
		"@epicenter/svelte": "workspace:*",
		"@epicenter/ui": "workspace:*",
		"@tanstack/svelte-query": "catalog:",
		"@tauri-apps/api": "catalog:",
		"buffer": "^6.0.3",
		"runed": "catalog:",
		"wellcrafted": "catalog:"
	},
	"devDependencies": {
		"@epicenter/vite-config": "workspace:*",
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tanstack/query-core": "catalog:",
		"@types/bun": "catalog:",
		"@types/jsdom": "21.1.7",
		"jsdom": "26.1.0",
		"playwright": "^1.61.1",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"license": "AGPL-3.0-or-later"
}
