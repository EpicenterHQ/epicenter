{
	"name": "@epicenter/capture-app",
	"description": "Capture and glance: a Markdown note per capture in the signed-in person's Epicenter repository, online only",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "NODE_ENV=production vite build",
		"dev:desktop": "tauri dev --config src-tauri/tauri.dev.conf.json",
		"build:desktop": "tauri build --bundles app",
		"preview": "vite preview",
		"contract": "bun scripts/write-contract.ts",
		"prepare": "svelte-kit sync || echo ''",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.scripts.json",
		"test": "bun run test:unit; failed=$?; bun run test:mounted && exit $failed",
		"test:unit": "bun test --isolate --path-ignore-patterns='**/*.mounted.test.ts' --conditions=browser --conditions=svelte --conditions=test src",
		"test:mounted": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun test --isolate --conditions=browser --conditions=svelte --conditions=test src/lib/components"
	},
	"dependencies": {
		"@epicenter/account": "workspace:*",
		"@epicenter/definition": "workspace:*",
		"@epicenter/folder": "workspace:*",
		"@epicenter/svelte": "workspace:*",
		"@epicenter/ui": "workspace:*",
		"@tauri-apps/api": "catalog:",
		"markdown-it": "^14.0.0",
		"wellcrafted": "catalog:"
	},
	"devDependencies": {
		"@epicenter/vite-config": "workspace:*",
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tauri-apps/cli": "catalog:",
		"@types/bun": "catalog:",
		"@types/jsdom": "21.1.7",
		"@types/markdown-it": "^14.0.0",
		"jsdom": "26.1.0",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"license": "AGPL-3.0-or-later"
}
