{
	"name": "@epicenter/capture-app",
	"description": "Capture and glance: a Markdown note per capture in the signed-in person's Epicenter repository, online only",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#platform/root": {
			"tauri": "./src/lib/root.tauri.ts",
			"default": "./src/lib/root.ts"
		},
		"#platform/variant": {
			"tauri": "./src/lib/variant.tauri.ts",
			"default": "./src/lib/variant.ts"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"build": "NODE_ENV=production vite build",
		"build:native": "EPICENTER_DESKTOP=1 CAPTURE_BUILD_DIR=build-desktop NODE_ENV=production vite build",
		"dev:desktop": "bun run build:native && tauri dev --config src-tauri/tauri.dev.conf.json",
		"build:desktop": "bun run build:native && tauri build --bundles app",
		"preview": "vite preview",
		"demo": "bun e2e/stack.ts --demo",
		"contract": "bun scripts/write-contract.ts",
		"prepare": "svelte-kit sync || echo ''",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig ./tsconfig.tauri.json && tsc -p tsconfig.scripts.json",
		"test": "bun test --isolate --path-ignore-patterns='**/*.mounted.test.ts' --conditions=browser --conditions=svelte src && bun run test:mounted",
		"test:mounted": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=0 bun test --isolate --conditions=browser --conditions=svelte src/lib/components",
		"test:e2e": "playwright test -c playwright.config.ts"
	},
	"dependencies": {
		"@epicenter/auth": "workspace:*",
		"@epicenter/capture": "workspace:*",
		"@epicenter/constants": "workspace:*",
		"@epicenter/definition": "workspace:*",
		"@epicenter/folder": "workspace:*",
		"@epicenter/svelte": "workspace:*",
		"@epicenter/ui": "workspace:*",
		"@tauri-apps/api": "catalog:",
		"wellcrafted": "catalog:"
	},
	"devDependencies": {
		"@epicenter/vite-config": "workspace:*",
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tauri-apps/cli": "catalog:",
		"@types/bun": "catalog:",
		"@types/jsdom": "21.1.7",
		"jsdom": "26.1.0",
		"playwright": "^1.61.1",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"license": "AGPL-3.0-or-later"
}
