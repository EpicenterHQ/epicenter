{
	"name": "@epicenter/recorder-demo",
	"description": "A small recorder over the file contract: recordings land in the browser first and upload to the signed-in person's repository",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
