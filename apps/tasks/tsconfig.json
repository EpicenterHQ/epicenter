{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"types": ["bun"],
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"moduleResolution": "bundler",
		"module": "esnext",
		"verbatimModuleSyntax": true,
		"skipLibCheck": true
	},
	"include": [".svelte-kit/ambient.d.ts", ".svelte-kit/non-ambient.d.ts", ".svelte-kit/types/**/$types.d.ts", "src/**/*.ts", "src/**/*.svelte", "epicenter.ts", "*.test.ts"]
}
