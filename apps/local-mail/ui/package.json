{
	"name": "@epicenter/local-mail-ui",
	"description": "Local Mail: the Epicenter application, built for the host and for the web.",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#platform/gmail-authorization": {
			"epicenter-host": "./src/lib/platform/gmail-authorization.epicenter-host.ts",
			"default": "./src/lib/platform/gmail-authorization.browser.ts"
		},
		"#platform/auth": {
			"epicenter-host": "./src/lib/platform/auth.epicenter-host.ts",
			"default": "./src/lib/platform/auth.browser.ts"
		}
	},
	"scripts": {
		"dev": "infisical run --silent --env=dev --path=/apps/local-mail --project-config-dir=../../api -- vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test:browser": "playwright test",
		"test:browser:install": "playwright install --with-deps chromium webkit",
		"prepare": "svelte-kit sync || echo ''",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig ./tsconfig.epicenter-host.json && svelte-check --tsconfig ./evidence/tsconfig.json"
	},
	"devDependencies": {
		"@playwright/test": "1.62.1",
		"@epicenter/sync": "workspace:*",
		"@epicenter/ui": "workspace:*",
		"@epicenter/vite-config": "workspace:*",
		"@lucide/svelte": "catalog:",
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@types/bun": "catalog:",
		"@types/jsdom": "^21.1.7",
		"jsdom": "^26.1.0",
		"mode-watcher": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"svelte-sonner": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"dependencies": {
		"@epicenter/app-shell": "workspace:*",
		"@epicenter/device": "workspace:*",
		"@epicenter/local-mail": "workspace:*",
		"@tanstack/svelte-query": "catalog:",
		"@tauri-apps/plugin-opener": "catalog:",
		"arkregex": "catalog:",
		"dompurify": "^3.4.10",
		"@epicenter/app": "workspace:*",
		"@epicenter/auth": "workspace:*",
		"@epicenter/constants": "workspace:*",
		"@epicenter/data": "workspace:*",
		"@epicenter/svelte": "workspace:*",
		"wellcrafted": "catalog:"
	},
	"license": "AGPL-3.0-or-later"
}
