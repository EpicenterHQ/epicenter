{
	"name": "@epicenter/local-mail-ui",
	"description": "Local Mail: the Epicenter application, built for the host and for the web.",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#platform/device": {
			"epicenter-host": "./src/lib/platform/device.epicenter-host.ts",
			"default": "./src/lib/platform/device.browser.ts"
		},
		"#platform/gmail-authorization": {
			"epicenter-host": "./src/lib/platform/gmail-authorization.epicenter-host.ts",
			"default": "./src/lib/platform/gmail-authorization.browser.ts"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig ./tsconfig.epicenter-host.json"
	},
	"devDependencies": {
		"@epicenter/ui": "workspace:*",
		"@epicenter/vite-config": "workspace:*",
		"@lucide/svelte": "catalog:",
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@types/bun": "catalog:",
		"@types/jsdom": "^21.1.7",
		"jsdom": "^26.1.0",
		"mode-watcher": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"svelte-sonner": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"dependencies": {
		"@epicenter/app-shell": "workspace:*",
		"@epicenter/device": "workspace:*",
		"@epicenter/local-mail": "workspace:*",
		"@tanstack/svelte-query": "catalog:",
		"@tauri-apps/plugin-opener": "catalog:",
		"arkregex": "catalog:",
		"dompurify": "^3.4.10"
	},
	"license": "AGPL-3.0-or-later"
}
