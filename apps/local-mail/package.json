{
	"name": "@epicenter/local-mail",
	"description": "Gmail cache and durable triage operations for the Local Mail application.",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"keywords": [
		"local-first",
		"gmail",
		"sqlite",
		"email"
	],
	"exports": {
		"./accounts": "./src/accounts.ts",
		"./authorization-return": "./src/authorization-return.ts",
		"./config": "./src/config.ts",
		"./handle": "./src/handle.ts",
		"./intent-store": "./src/intent-store.ts",
		"./mailbox": "./src/mailbox.ts",
		"./oauth": "./src/oauth.ts",
		"./outbox": "./src/outbox.ts",
		"./storage": "./src/storage.ts",
		"./sync": "./src/sync.ts"
	},
	"scripts": {
		"build": "bun run --cwd ui build",
		"build:epicenter": "EPICENTER_HOST=1 bun run --cwd ui build",
		"check:gmail-drift": "bun run test-support/check-gmail-discovery.ts",
		"test": "bun test",
		"test:browser": "bun run --cwd ui test:browser",
		"typecheck": "tsc --noEmit && tsc --noEmit -p test-support/tsconfig.json"
	},
	"dependencies": {
		"@epicenter/device": "workspace:*",
		"@epicenter/data": "workspace:*",
		"oauth4webapi": "catalog:",
		"typebox": "catalog:",
		"wellcrafted": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"typescript": "catalog:"
	},
	"license": "AGPL-3.0-or-later"
}
