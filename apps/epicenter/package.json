{
	"name": "@epicenter/epicenter",
	"description": "One desktop application host serving trusted Epicenter SPAs and the Home session from Bun.",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"exports": {
		".": "./src/host.ts"
	},
	"scripts": {
		"build": "bun run scripts/with-build-lock.ts bun run build:apps",
		"build:apps": "bun run clean:dist && bun run build:home && bun run build:folders",
		"build:desktop": "bun run build && bun run build:sidecar",
		"build:folders": "vite build --config vite.folders.config.ts",
		"build:home": "vite build",
		"build:sidecar": "bun run scripts/build-sidecar.ts",
		"clean:dist": "bun run scripts/clean-dist.ts",
		"desktop:build": "tauri build",
		"dev": "bun run dev:desktop",
		"dev:desktop": "tauri dev --config src-tauri/tauri.dev.conf.json",
		"tauri": "tauri",
		"test": "bun test",
		"typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"openai": "^7.12.1",
		"@epicenter/agent": "workspace:*",
		"@epicenter/definition": "workspace:*",
		"@epicenter/folder": "workspace:*",
		"@epicenter/auth": "workspace:*",
		"@epicenter/client": "workspace:*",
		"@epicenter/constants": "workspace:*",
		"@epicenter/principal": "workspace:*",
		"@epicenter/server": "workspace:*",
		"@epicenter/svelte": "workspace:*",
		"@epicenter/ui": "workspace:*",
		"@modelcontextprotocol/sdk": "catalog:",
		"@tanstack/svelte-query": "catalog:",
		"@tauri-apps/api": "catalog:",
		"hono": "catalog:",
		"mime": "catalog:",
		"runed": "catalog:",
		"typebox": "catalog:",
		"wellcrafted": "catalog:"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@tauri-apps/cli": "catalog:",
		"@types/bun": "catalog:",
		"fake-indexeddb": "^6.2.5",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plugin-singlefile": "catalog:"
	},
	"license": "AGPL-3.0-or-later"
}
