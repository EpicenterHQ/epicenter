{
	"name": "@epicenter/epicenter",
	"description": "The Epicenter desktop app: Rust serves its pages and the apps it bundles from one origin.",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"build": "bun run scripts/with-build-lock.ts bun run build:apps",
		"build:apps": "bun run clean:dist && bun run build:home && bun run build:folders && bun run build:bundled",
		"build:bundled": "bun run scripts/build-bundled-apps.ts",
		"build:desktop": "bun run build && bun run build:sidecar",
		"build:folders": "vite build --config vite.folders.config.ts",
		"build:home": "vite build",
		"build:sidecar": "bun run scripts/build-sidecar.ts",
		"clean:dist": "bun run scripts/clean-dist.ts",
		"desktop:build": "tauri build",
		"dev": "bun run dev:desktop",
		"dev:desktop": "tauri dev --config src-tauri/tauri.dev.conf.json",
		"tauri": "tauri",
		"test": "bun test",
		"test:mounted": "bun test --conditions=browser --conditions=svelte src/folders/*.mounted.test.ts",
		"typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"@epicenter/ai": "workspace:*",
		"@epicenter/definition": "workspace:*",
		"@epicenter/folder": "workspace:*",
		"@epicenter/cli": "workspace:*",
		"@epicenter/svelte": "workspace:*",
		"@epicenter/ui": "workspace:*",
		"@tanstack/svelte-query": "catalog:",
		"@tauri-apps/api": "catalog:",
		"runed": "catalog:",
		"typebox": "catalog:",
		"wellcrafted": "catalog:"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@tauri-apps/cli": "catalog:",
		"@types/bun": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"license": "AGPL-3.0-or-later"
}
