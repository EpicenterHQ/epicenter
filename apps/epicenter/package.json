{
	"name": "@epicenter/epicenter",
	"description": "One desktop application host serving trusted Epicenter SPAs and the Home session from Bun.",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"exports": {
		".": "./src/host.ts",
		"./departure": "./src/departure-wire.ts",
		"./departure/page": "./src/departure-page.svelte.ts",
		"./departure/window": "./src/departure-window.ts"
	},
	"scripts": {
		"build": "bun run scripts/with-build-lock.ts bun run build:apps",
		"build:apps": "bun run clean:dist && bun run build:home && bun run build:whispering && bun run build:capture && bun run build:todos && bun run build:folders",
		"build:desktop": "bun run build && bun run build:sidecar",
		"build:folders": "vite build --config vite.folders.config.ts",
		"build:home": "vite build",
		"build:capture": "bun run --cwd ../capture build:epicenter",
		"build:sidecar": "bun run scripts/build-sidecar.ts",
		"build:todos": "bun run --cwd ../todos build:epicenter",
		"build:whispering": "bun run --cwd ../whispering build:epicenter",
		"clean:dist": "bun run scripts/clean-dist.ts",
		"desktop:build": "tauri build",
		"dev": "bun run dev:desktop",
		"dev:desktop": "tauri dev --config src-tauri/tauri.dev.conf.json",
		"tauri": "tauri",
		"test": "bun test",
		"typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
		"typecheck:desktop": "bun run typecheck && bun run --cwd ../whispering typecheck && bun run --cwd ../capture typecheck && bun run --cwd ../todos typecheck"
	},
	"dependencies": {
		"openai": "^7.12.1",
		"@epicenter/agent": "workspace:*",
		"@epicenter/device": "workspace:*",
		"@epicenter/auth": "workspace:*",
		"@epicenter/blobs": "workspace:*",
		"@epicenter/client": "workspace:*",
		"@epicenter/constants": "workspace:*",
		"@epicenter/matter-core": "workspace:*",
		"@epicenter/principal": "workspace:*",
		"@epicenter/server": "workspace:*",
		"@epicenter/sqlite": "workspace:*",
		"@epicenter/todos": "workspace:*",
		"@epicenter/ui": "workspace:*",
		"@epicenter/whispering": "workspace:*",
		"@modelcontextprotocol/sdk": "catalog:",
		"@tauri-apps/api": "catalog:",
		"hono": "catalog:",
		"mime": "catalog:",
		"wellcrafted": "catalog:"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@tauri-apps/cli": "catalog:",
		"@types/bun": "catalog:",
		"fake-indexeddb": "^6.2.5",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plugin-singlefile": "catalog:"
	},
	"license": "AGPL-3.0-or-later"
}
