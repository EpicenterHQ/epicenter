{
	"name": "@epicenter/epicenter",
	"description": "The Epicenter desktop app: registers, syncs, and shares folders. Rust serves its pages from one origin.",
	"private": true,
	"version": "0.0.2",
	"type": "module",
	"scripts": {
		"build": "bun run scripts/with-build-lock.ts bun run build:apps",
		"build:apps": "bun run clean:dist && bun run build:home && bun run build:folders",
		"build:desktop": "bun run build && bun run build:sidecar",
		"build:desktop:dev": "bun run build && bun run build:sidecar:dev",
		"build:folders": "vite build --config vite.folders.config.ts",
		"build:home": "vite build",
		"build:sidecar": "bun run scripts/build-sidecar.ts",
		"build:sidecar:dev": "bun run scripts/build-sidecar.ts development",
		"clean:dist": "bun run scripts/clean-dist.ts",
		"desktop:build": "tauri build",
		"dev": "bun run dev:desktop",
		"dev:desktop": "tauri dev --config src-tauri/tauri.dev.conf.json",
		"tauri": "tauri",
		"release:build": "bun scripts/release.ts build",
		"release:rehearse": "bun scripts/rehearse-release.ts",
		"test": "bun test",
		"typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"@epicenter/cli": "workspace:*",
		"@epicenter/transcription": "workspace:*",
		"@epicenter/ui": "workspace:*",
		"@tauri-apps/api": "catalog:"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@tauri-apps/cli": "catalog:",
		"@types/bun": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"license": "AGPL-3.0-or-later"
}
