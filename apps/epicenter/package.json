{
	"name": "@epicenter/epicenter",
	"description": "One desktop application host serving trusted Epicenter SPAs and the Home session from Bun.",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"exports": {
		".": "./src/host.ts"
	},
	"scripts": {
		"dev": "bun run dev:desktop",
		"dev:desktop": "tauri dev --config src-tauri/tauri.dev.conf.json",
		"remote:dev": "bun run scripts/remote-dev-smoke.ts",
		"build": "bun run clean:dist && bun run build:home && bun run build:whispering",
		"build:home": "vite build",
		"build:sidecar": "bun run scripts/build-sidecar.ts",
		"build:whispering": "bun run --cwd ../whispering build:epicenter",
		"clean:dist": "bun run scripts/clean-dist.ts",
		"build:desktop": "bun run build && bun run build:sidecar",
		"catalog:publish": "bun run scripts/publish-app-catalog.ts",
		"desktop:build": "tauri build",
		"test": "bun test",
		"tauri": "tauri",
		"typecheck": "bun run typecheck:home && bun run --cwd ../whispering typecheck",
		"typecheck:home": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"@epicenter/agent": "workspace:*",
		"@epicenter/auth": "workspace:*",
		"@epicenter/blobs": "workspace:*",
		"@epicenter/chat": "workspace:*",
		"@epicenter/client": "workspace:*",
		"@epicenter/constants": "workspace:*",
		"@epicenter/data": "workspace:*",
		"@epicenter/document-sync": "workspace:*",
		"@epicenter/field": "workspace:*",
		"@epicenter/honeycrisp": "workspace:*",
		"@epicenter/server": "workspace:*",
		"@epicenter/skills": "workspace:*",
		"@epicenter/sync": "workspace:*",
		"@epicenter/ui": "workspace:*",
		"@epicenter/whispering": "workspace:*",
		"@modelcontextprotocol/sdk": "catalog:",
		"@tauri-apps/api": "catalog:",
		"hono": "catalog:",
		"mime": "catalog:",
		"wellcrafted": "catalog:"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@tauri-apps/cli": "catalog:",
		"@types/bun": "catalog:",
		"fake-indexeddb": "^6.2.5",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plugin-singlefile": "catalog:"
	},
	"license": "AGPL-3.0-or-later"
}
