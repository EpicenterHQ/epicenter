{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "close-flush-production",
	"description": "Capture and Todos hear the host's flush before it quits or restarts, and say when they are done.",
	"local": false,
	"windows": ["capture", "todos"],
	"remote": {
		"urls": ["http://127.0.0.1:39130"]
	},
	"permissions": [
		"core:event:allow-listen",
		"core:event:allow-unlisten",
		"allow-flush-done"
	]
}
