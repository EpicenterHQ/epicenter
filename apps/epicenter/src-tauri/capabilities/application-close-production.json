	"windows": ["app-*", "whispering", "honeycrisp", "mail"],
	"remote": {
		"urls": ["http://127.0.0.1:39130"]
	},
	"permissions": [
		"core:event:allow-listen",
		"core:event:allow-unlisten",
		"allow-finish-application-close"
	]
}
