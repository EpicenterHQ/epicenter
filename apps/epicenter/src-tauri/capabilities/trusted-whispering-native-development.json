{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "trusted-whispering-native-development",
	"description": "Development origin variant of the focused Whispering native capability.",
	"local": false,
	"windows": ["whispering"],
	"remote": {
		"urls": ["http://127.0.0.1:*"]
	},
	"permissions": [
		"core:default",
		"core:event:allow-emit",
		"core:event:allow-listen",
		"core:window:allow-hide",
		"core:window:allow-show",
		"core:window:allow-close",
		"core:window:allow-set-focus",
		"core:window:allow-unminimize",
		"core:window:allow-set-size",
		"core:window:allow-set-position",
		"allow-write-text",
		"allow-simulate-enter-keystroke",
		"allow-simulate-copy-keystroke",
		"allow-enumerate-recording-devices",
		"allow-start-recording",
		"allow-stop-recording",
		"allow-cancel-recording",
		"allow-register-recording-session",
		"allow-current-recording",
		"allow-resolve-recording-start",
		"allow-close-recording-session",
		"allow-publish-recording-file",
		"allow-attachment-transfer-epoch",
		"allow-transfer-attachment",
		"allow-cancel-attachment-transfer",
		"allow-discard-recording-file",
		"allow-encode-recording-for-upload",
		"allow-transcribe-recording",
		"allow-prewarm-model",
		"allow-get-local-transcription-readiness",
		"allow-open-home",
		"allow-open-accessibility-settings",
		"allow-request-accessibility-permission",
		"allow-get-microphone-permission",
		"allow-request-microphone-permission",
		"allow-pause-playback",
		"allow-resume-playback",
		"allow-set-auto-paste-enabled",
		"allow-get-dictation-capability",
		"allow-replace-global-shortcuts",
		"allow-is-autostart-enabled",
		"allow-set-autostart-enabled",
		"dialog:allow-open",
		"dialog:allow-save",
		"deep-link:default",
		"log:default",
		"notification:default",
		"opener:allow-default-urls",
		"opener:allow-open-url",
		"os:default"
	]
}
