{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Epicenter",
	"version": "0.0.2",
	"identifier": "so.epicenter",
	"build": {
		"beforeBuildCommand": "bun run build:desktop",
		"beforeDevCommand": {
			"script": "bun run build:desktop",
			"wait": true
		}
	},
	"app": {
		"macOSPrivateApi": true,
		"windows": [],
		"security": {
			"capabilities": ["folders", "home"]
		}
	},
	"bundle": {
		"active": true,
		"targets": ["app"],
		"category": "Productivity",
		"publisher": "Epicenter",
		"copyright": "Copyright © 2026 Epicenter",
		"shortDescription": "Registers, syncs, and shares your Epicenter folders",
		"externalBin": ["binaries/epicenter-cli"],
		"resources": {
			"../dist": "apps-dist"
		},
		"icon": ["icons/icon.png", "icons/icon.icns"],
		"macOS": {
			"entitlements": "entitlements.plist",
			"hardenedRuntime": true,
			"minimumSystemVersion": "10.15",
			"signingIdentity": "-"
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "",
			"endpoints": ["https://updates.epicenter.so/epicenter/stable.json"],
			"requireSignedVersion": true
		},
		"deep-link": {
			"desktop": {
				"schemes": ["epicenter"]
			}
		}
	}
}
