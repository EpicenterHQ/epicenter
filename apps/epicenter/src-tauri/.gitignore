/target/
/gen/schemas/
# The host-triple-specific compiled `epicenter` binary is regenerated by
# `bun run build:sidecar` and by Tauri's production beforeBuildCommand.
/binaries/
# Platform builds stage transcribe-cpp runtime libraries here. macOS keeps the
# directory empty because its Metal backend links statically.
/transcribe-libs/
# Only a `dictation` build declares these commands, so only it generates their
# permissions; the default build carries none of them.
/permissions/autogenerated/write_text.toml
/permissions/autogenerated/simulate_enter_keystroke.toml
/permissions/autogenerated/prewarm_model.toml
/permissions/autogenerated/pause_playback.toml
/permissions/autogenerated/resume_playback.toml
/permissions/autogenerated/set_auto_paste_enabled.toml
/permissions/autogenerated/get_dictation_capability.toml
