{
	"name": "epicenter",
	"type": "module",
	"private": true,
	"version": "7.11.0",
	"description": "Where one person's software lives: small apps as folders of plain files, run by the epicenter command on a computer you control.",
	"keywords": [
		"local-first",
		"markdown",
		"open-source",
		"self-hosted"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/EpicenterHQ/epicenter.git"
	},
	"homepage": "https://epicenter.so",
	"license": "AGPL-3.0-or-later",
	"author": "",
	"workspaces": {
		"packages": [
			"apps/*",
			"apps/whispering/packages/*",
			"packages/*"
		],
		"catalog": {
			"@types/node": "^24.0.0",
			"@types/bun": "^1.3.14",
			"typescript": "^5.9.3",
			"svelte": "^5.56.3",
			"@sveltejs/kit": "^2.65.1",
			"@sveltejs/vite-plugin-svelte": "^7.3.0",
			"svelte-check": "^4.3.4",
			"vite": "^8.2.2",
			"tailwindcss": "^4.1.17",
			"bits-ui": "~2.21.0",
			"mode-watcher": "^1.1.0",
			"svelte-sonner": "^1.0.6",
			"@lucide/svelte": "^0.561.0",
			"@tanstack/query-core": "5.107.1",
			"@tanstack/svelte-query": "^6.4.1",
			"nanoid": "^5.1.14",
			"wellcrafted": "^0.47.1",
			"@ricky0123/vad-web": "^0.0.30",
			"@biomejs/biome": "^2.5.15",
			"wrangler": "^4.71.0",
			"typebox": "^1.0.0",
			"@tailwindcss/vite": "^4.1.11",
			"@sveltejs/adapter-static": "^3.0.8",
			"@tauri-apps/api": "^2.12.0",
			"@tauri-apps/plugin-dialog": "^2.8.3",
			"@tauri-apps/plugin-http": "^2.5.0",
			"@tauri-apps/plugin-opener": "^2.4.0",
			"@tauri-apps/cli": "^2.12.0",
			"@modelcontextprotocol/sdk": "^1.29.0"
		}
	},
	"packageManager": "bun@1.4.2",
	"overrides": {
		"@protobufjs/utf8": "^1.1.1",
		"cookie": "^1.1.1",
		"esbuild": "^0.28.1",
		"fast-uri": "^3.1.2",
		"postcss": "^8.5.15",
		"protobufjs": "^7.6.4",
		"qs": "^6.15.2",
		"uuid": "^11.1.1",
		"vite": "^8.2.2",
		"ws": "^8.21.0",
		"yaml": "^2.9.0"
	},
	"bin": {
		"epicenter": "./packages/app/src/command/bin.ts"
	},
	"scripts": {
		"epicenter": "bun --no-install packages/app/src/command/bin.ts",
		"build": "bun run --filter '*' build",
		"build:whispering:desktop": "bun run --cwd apps/whispering build:desktop",
		"check": "bun run scripts/check.ts",
		"dev:landing": "bun run --cwd apps/landing dev",
		"dev:whispering": "bun run --cwd apps/whispering dev",
		"dev:whispering:desktop": "bun run --cwd apps/whispering dev:desktop",
		"format": "biome check --write --linter-enabled=false",
		"lint": "biome lint --write",
		"typecheck": "bun run scripts/typecheck.ts",
		"test": "bun run scripts/test.ts",
		"check:ui-boundary": "bun run scripts/check-ui-boundary.ts",
		"check:doc-paths": "bun run scripts/check-doc-paths.ts",
		"check:boot-purity": "bun run scripts/check-boot-purity.ts",
		"check:catalog-pins": "bun run scripts/check-catalog-pins.ts",
		"worktrees": "bun run scripts/worktree-audit.ts",
		"clean": "bun run scripts/clean.ts",
		"nuke": "bun run scripts/clean.ts --nuke",
		"cf:audit:remote": "infisical run --env=prod --path=/ops --projectId=d5ce3d3d-7db2-4a7f-bf98-fb9d0fdb7b89 -- bun run scripts/cf-audit.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@types/bun": "catalog:",
		"knip": "6.46.1",
		"wrangler": "catalog:"
	}
}
