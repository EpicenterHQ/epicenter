{
	"name": "epicenter",
	"type": "module",
	"private": true,
	"version": "7.11.0",
	"description": "Local-first PKM substrate. CRDT-powered tables that materialize to SQLite and markdown.",
	"keywords": [
		"local-first",
		"CRDT",
		"Yjs",
		"offline-first",
		"personal knowledge base",
		"PKM",
		"second brain",
		"SQLite",
		"markdown",
		"open-source",
		"self-hosted",
		"workspace"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/EpicenterHQ/epicenter.git"
	},
	"homepage": "https://epicenter.so",
	"license": "SEE LICENSE IN LICENSE",
	"author": "",
	"workspaces": {
		"packages": [
			"apps/*",
			"apps/api/ui",
			"apps/local-books/ui",
			"ops",
			"packages/*",
			"examples/*"
		],
		"catalog": {
			"@types/node": "^24.0.0",
			"@types/bun": "^1.3.14",
			"@types/ms": "^2.1.0",
			"aws4fetch": "^1.0.20",
			"ms": "^2.1.3",
			"typescript": "^5.9.3",
			"svelte": "^5.56.3",
			"@sveltejs/kit": "^2.65.1",
			"@sveltejs/vite-plugin-svelte": "^7.3.0",
			"svelte-check": "^4.3.4",
			"vite": "^8.2.2",
			"vite-plugin-singlefile": "^2.3.3",
			"tailwindcss": "^4.1.17",
			"clsx": "^2.1.1",
			"tailwind-merge": "^3.4.0",
			"tailwind-variants": "^3.2.2",
			"bits-ui": "^2.14.4",
			"mode-watcher": "^1.1.0",
			"svelte-sonner": "^1.0.6",
			"runed": "^0.36.0",
			"@lucide/svelte": "^0.561.0",
			"@tanstack/query-core": "5.96.2",
			"@tanstack/svelte-query": "^6.0.10",
			"@tanstack/svelte-query-devtools": "^6.0.2",
			"@tanstack/svelte-table": "9.0.0-alpha.10",
			"arkregex": "^0.0.5",
			"arktype": "^2.1.29",
			"drizzle-arktype": "^0.1.3",
			"drizzle-kit": "^0.31.7",
			"drizzle-orm": "^0.45.2",
			"nanoid": "^5.1.14",
			"wellcrafted": "^0.44.0",
			"@ricky0123/vad-web": "^0.0.30",
			"date-fns": "^4.1.0",
			"@biomejs/biome": "^2.4.10",
			"wrangler": "^4.71.0",
			"@standard-schema/spec": "^1.1.0",
			"hono": "^4.12.25",
			"mime": "^4.0.6",
			"typebox": "^1.0.0",
			"better-auth": "1.7.9",
			"@better-auth/cimd": "1.7.9",
			"@better-auth/core": "1.7.9",
			"@better-auth/drizzle-adapter": "1.7.9",
			"@better-auth/oauth-provider": "1.7.9",
			"@better-auth/passkey": "1.7.9",
			"jose": "^6.2.2",
			"jsrepo": "^3.6.2",
			"@tailwindcss/vite": "^4.1.11",
			"@hono/standard-validator": "^0.2.2",
			"hono-openapi": "^1.3.0",
			"fflate": "^0.8.2",
			"@sveltejs/adapter-static": "^3.0.8",
			"@sveltejs/adapter-auto": "^6.1.0",
			"@tailwindcss/typography": "^0.5.19",
			"@sindresorhus/slugify": "^3.0.0",
			"@tauri-apps/api": "^2.12.0",
			"@tauri-apps/plugin-deep-link": "^2.4.9",
			"@tauri-apps/plugin-opener": "^2.4.0",
			"@tauri-apps/cli": "^2.12.0",
			"marked": "^17.0.3",
			"virtua": "^0.48.5",
			"oauth4webapi": "^3.8.6",
			"@modelcontextprotocol/sdk": "^1.29.0",
			"yaml": "^2.9.0"
		}
	},
	"packageManager": "bun@1.4.2",
	"overrides": {
		"@y/y": "14.0.0-rc.26",
		"lib0": "1.0.0-rc.32",
		"@protobufjs/utf8": "^1.1.1",
		"axios": "^1.18.0",
		"brace-expansion": "^5.0.6",
		"cookie": "^1.1.1",
		"esbuild": "^0.28.1",
		"fast-uri": "^3.1.2",
		"fast-xml-builder": "^1.2.0",
		"fast-xml-parser": "^5.8.0",
		"follow-redirects": "^1.16.0",
		"fx-runner": "^1.5.0",
		"postcss": "^8.5.15",
		"protobufjs": "^7.6.4",
		"qs": "^6.15.2",
		"shell-quote": "^1.8.4",
		"tmp": "^0.2.7",
		"uuid": "^11.1.1",
		"vite": "^8.2.2",
		"vite-node": "^5.3.0",
		"ws": "^8.21.0",
		"yaml": "^2.9.0"
	},
	"bin": {
		"epicenter": "./packages/cli/src/bin.ts"
	},
	"scripts": {
		"epicenter": "bun --no-install packages/cli/src/bin.ts",
		"build": "bun run --filter '*' build",
		"check": "bun run lint:ci && bun run typecheck && bun run test && bun run check:structure",
		"dev": "bun run dev:honeycrisp",
		"dev:api": "bun run --cwd apps/api dev",
		"dev:capture": "bun run --cwd apps/capture dev",
		"dev:capture:ui": "bun run --cwd apps/capture dev",
		"dev:api-dashboard": "API_PUBLIC_ORIGIN=http://localhost:5178 bun run --filter @epicenter/api --filter @epicenter/api-ui dev",
		"dev:api-dashboard:ui": "bun run --cwd apps/api/ui dev",
		"dev:epicenter": "EPICENTER_API_URL=http://localhost:8787 bun run --filter @epicenter/api --filter @epicenter/epicenter dev",
		"dev:honeycrisp": "bun run --cwd apps/honeycrisp dev",
		"dev:honeycrisp:ui": "bun run --cwd apps/honeycrisp dev:ui",
		"dev:landing": "bun run --cwd apps/landing dev",
		"dev:posthog-reverse-proxy": "bun run --cwd apps/posthog-reverse-proxy dev",
		"dev:todos": "bun run --filter @epicenter/api --filter @epicenter/todos dev",
		"dev:todos:ui": "bun run --cwd apps/todos dev:ui",
		"dev:vocab": "bun run --filter @epicenter/api --filter @epicenter/vocab dev",
		"dev:vocab:ui": "bun run --cwd apps/vocab dev",
		"dev:whispering": "bun run --cwd apps/whispering dev",
		"dev:whispering:ui": "bun run --cwd apps/whispering dev:ui",
		"smoke:local": "bun run --cwd apps/api smoke:local",
		"format": "biome check --write --linter-enabled=false",
		"format:check": "biome ci --linter-enabled=false",
		"lint": "biome lint --write",
		"lint:check": "biome lint",
		"lint:ci": "biome lint --diagnostic-level=error --reporter=github",
		"typecheck": "bun run --filter '*' typecheck && bun x tsc --noEmit -p scripts/tsconfig.json",
		"test": "bun test ./scripts/*.test.ts ./.agents/skills/*/scripts/*.test.ts && bun run --filter '*' test",
		"bench": "bun run --filter '*' bench",
		"check:ui-boundary": "bun run scripts/check-ui-boundary.ts",
		"check:doc-paths": "bun run scripts/check-doc-paths.ts",
		"check:boot-purity": "bun run scripts/check-boot-purity.ts",
		"check:doc-hygiene": "bun run scripts/check-doc-hygiene.ts",
		"check:catalog-pins": "bun run scripts/check-catalog-pins.ts",
		"check:api-paths": "bun run scripts/check-api-paths.ts",
		"check:vocabulary": "bun run scripts/check-vocabulary.ts",
		"check:structure": "bun run check:doc-paths && bun run check:catalog-pins && bun run check:api-paths && bun run check:ui-boundary && bun run check:boot-purity && bun run check:vocabulary",
		"gen:spec-history": "bun run scripts/generate-spec-history.ts",
		"bump-version": "bun run scripts/bump-version.ts",
		"clean": "bun run scripts/clean.ts",
		"nuke": "bun run scripts/clean.ts --nuke",
		"cf:audit:remote": "bun run --cwd ops cf:audit:remote",
		"jsrepo:build": "jsrepo build",
		"build:honeycrisp:ui": "bun run --cwd apps/honeycrisp build",
		"dev:git": "bun run --cwd apps/git dev"
	},
	"devDependencies": {
		"@y/y": "14.0.0-rc.26",
		"@biomejs/biome": "catalog:",
		"@types/bun": "catalog:",
		"jsrepo": "^3.6.2",
		"wrangler": "catalog:"
	},
	"dependencies": {
		"@epicenter/constants": "workspace:*",
		"tinyexec": "^1.0.4"
	},
	"patchedDependencies": {
		"@better-auth/oauth-provider@1.7.9": "patches/@better-auth%2Foauth-provider@1.7.9.patch"
	}
}
