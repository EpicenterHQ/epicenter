{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"css": {
		"parser": {
			"cssModules": true,
			"tailwindDirectives": true
		}
	},
	"html": {
		"experimentalFullSupportEnabled": true,
		"formatter": { "enabled": true, "indentScriptAndStyle": true }
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!**/.svelte-kit",
			"!**/.astro",
			"!**/node_modules",
			"!**/build",
			"!**/dist",
			// Written by `tauri_specta` on every `cargo test`, which has no
			// formatter hook. Formatting them made every Rust test run dirty
			// two files it did not change, so the generator's output is the
			// committed form. `typecheck` still reads them.
			"!**/bindings.gen.ts",
			// Written by the `tauri-plugin` build script on every cargo build of a
			// plugin, for the same reason: the generator's output is the committed form.
			"!**/permissions/schemas/schema.json",
			// Upstream snapshots stay as the shadcn-svelte CLI wrote them; the kit is checked against them.
			"!packages/ui/upstream",
			"!**/.gitignore",
			"!.DS_Store",
			"!**/*.md",
			// svelte-check owns .svelte files. Biome's HTML/Svelte parser
			// rejects valid Svelte 5 syntax (e.g. value-less `{:then}`),
			// and the rules it can apply to script blocks duplicate what
			// svelte-check already enforces via TypeScript.
			"!**/*.svelte"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"identifierOrder": "natural"
					}
				}
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"nursery": {
				"useSortedClasses": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single"
		}
	},
	"overrides": [
		{
			// Library code logs through `wellcrafted/logger`, so its host decides
			// where output goes. A benchmark exists to print its report. Any
			// other deliberate call carries a `biome-ignore` with its reason.
			"includes": ["packages/*/src/**", "!**/*.bench.ts"],
			"linter": {
				"rules": { "suspicious": { "noConsole": "error" } }
			}
		},
		{
			// Biome can lint <script> blocks in .astro components but can't see
			// template usage, so imports and handlers used only in templates
			// appear unused. (.svelte files are excluded from Biome entirely;
			// svelte-check owns them.)
			"includes": ["**/*.astro"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					},
					"style": {
						"useImportType": "off",
						"noNonNullAssertion": "off"
					},
					"suspicious": {
						"noConfusingVoidType": "off",
						"noTemplateCurlyInString": "off",
						"useIterableCallbackReturn": "off",
						"noExplicitAny": "off"
					},
					"a11y": {
						// SVG icons in components don't always need <title>
						"noSvgWithoutTitle": "off",
						// Astro components often omit button type in templates
						"useButtonType": "off",
						// autofocus is intentional UX in dialogs and forms
						"noAutofocus": "off",
						// Audio recording playback doesn't have captions
						"useMediaCaption": "off"
					}
				}
			}
		},
		{
			// Upstream shadcn-svelte barrels export parts by short names such as
			// `Field.Error` and `Field.Set`, and `packages/ui/scripts/upstream.ts`
			// checks these files against upstream's text, so the names stay.
			"includes": ["packages/ui/src/*/index.ts"],
			"linter": {
				"rules": { "suspicious": { "noShadowRestrictedNames": "off" } }
			}
		},
		{
			// Vendored PostHog analytics snippet — minified code, not worth linting
			"includes": ["**/posthog.astro"],
			"linter": { "enabled": false }
		}
	]
}
