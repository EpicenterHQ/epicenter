{
	"name": "@examples/sqlite-workspace-browser",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"check:workspace-version-lock": "bun run ../../scripts/check-workspace-version-locks.ts --check --lock workspace-version-lock.json --candidate src/versions/v1/workspace.ts --candidate src/versions/v2/workspace.ts",
		"workspace-version-lock": "bun run ../../scripts/check-workspace-version-locks.ts --write --lock workspace-version-lock.json --candidate src/versions/v1/workspace.ts --candidate src/versions/v2/workspace.ts",
		"smoke": "bun run build && bun run smoke.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@epicenter/field": "workspace:*",
		"@epicenter/identity": "workspace:*",
		"@epicenter/server": "workspace:*",
		"@epicenter/workspace": "workspace:*",
		"hono": "catalog:",
		"yjs": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"playwright": "^1.61.1",
		"typescript": "catalog:",
		"vite": "catalog:"
	}
}
